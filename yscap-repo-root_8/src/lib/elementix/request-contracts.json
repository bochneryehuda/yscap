{
  "_README": [
    "HOW EVERY ELEMENTIX REQUEST MUST LOOK — transcribed 2026-08-09 from the live",
    "MCP connector's own tool schemas (the same connector Claude uses directly),",
    "at the owner's direction: 'bring all the information you know into our system",
    "so that our systems should know exactly how to pull the requests the same way",
    "you know how to pull the requests.'",
    "",
    "WHY THIS FILE EXISTS. The vendor answers a malformed request with a raw",
    "validation error (-32602), which reached the owner's screen five times in one",
    "search — and each refused call still spends a slot of the office's shared",
    "hourly allowance. lookups.js reads this file BEFORE sending anything, so a",
    "request our own code shapes wrongly is refused HERE, with a plain sentence,",
    "at zero cost. The pure test runs every wrapper against this file.",
    "",
    "RULES LEARNED FROM THE LIVE SCHEMAS — the ones that have already bitten:",
    "  · match_entity and match_person REQUIRE `state` — entities and persons are",
    "    keyed (name, state); the same name in another state is a DIFFERENT record",
    "    (proven live: 'MW TRADING LLC' is one entity in NJ and another in CA).",
    "    For a no-state lookup the vendor's own guidance is `search` with",
    "    entityFilter 'entity'/'person', which takes an OPTIONAL state filter.",
    "  · get_document takes `type` AND `id` — both required, and the id parameter",
    "    is `id`, never `documentId`.",
    "  · get_coverage filters `state` as an ARRAY of codes and has NO county",
    "    parameter at all — a county question is answered by reading the state's",
    "    rows and picking the county client-side.",
    "  · Every entity/person/address detail tool takes `id` (never entityId /",
    "    personId / addressId) and pages with `perPage` (never `limit`, which is",
    "    ignored silently; the default page is 5, the ceiling 5000 — we cap at 100",
    "    deliberately, see lookups.pageArgs).",
    "  · `search` needs a query of at least 3 characters and returns at most 20",
    "    rows ({results, resultLimit:20}) — it is not paginated.",
    "",
    "Updating this file is a deliberate act: re-read the live connector's schema",
    "for the tool first, and keep scripts/fixtures/elementix-shapes.json (response",
    "shapes) in the same pass when a response changed too."
  ],

  "tools": {
    "search": {
      "required": ["query"],
      "params": {
        "query": { "type": "string", "minLength": 3, "maxLength": 500 },
        "entityFilter": { "enum": ["all", "person", "company", "lender", "entity", "address"] },
        "state": { "type": "state" }
      }
    },

    "match_entity": {
      "_note": "Deterministic: one result or nothing. State REQUIRED — (name, state) is the key. No entityFilter here; that belongs to `search`.",
      "required": ["name", "state"],
      "params": {
        "name": { "type": "string", "minLength": 2, "maxLength": 300 },
        "state": { "type": "state" }
      }
    },

    "match_person": {
      "_note": "Deterministic: one result or nothing. State REQUIRED — (name, state) is the key, same as entities.",
      "required": ["name", "state"],
      "params": {
        "name": { "type": "string", "minLength": 2, "maxLength": 300 },
        "state": { "type": "state" }
      }
    },

    "match_address": {
      "required": ["address"],
      "params": {
        "address": { "type": "string", "minLength": 3, "maxLength": 500 }
      }
    },

    "get_entity_deeds": {
      "required": ["id"],
      "params": {
        "id": { "type": "uuid" },
        "page": { "type": "int" }, "perPage": { "type": "int", "min": 1, "max": 5000 },
        "scope": { "enum": ["data", "count"] },
        "sortBy": { "type": "string" }, "sortOrder": { "enum": ["asc", "desc"] },
        "state": { "type": "string[]" }, "city": { "type": "string[]" }, "countyName": { "type": "string[]" },
        "zipCode": { "type": "string[]" }, "region": { "type": "string[]" },
        "propertyTypes": { "type": "string[]" }, "propertySubtypes": { "type": "string[]" },
        "ids": { "type": "string[]" },
        "dateStart": { "type": "string" }, "dateEnd": { "type": "string" },
        "fundingType": { "enum": ["cash", "financed"] },
        "isBusinessPurpose": { "type": "boolean" },
        "amountMin": { "type": "number" }, "amountMax": { "type": "number" },
        "bounds": { "type": "string" },
        "mlsListingType": { "enum": ["sale", "rent"] },
        "mlsStatus": { "enum": ["sold", "active", "pending", "contingent", "off_market"] },
        "mlsPriceMin": { "type": "number" }, "mlsPriceMax": { "type": "number" },
        "mlsDomMin": { "type": "int" }, "mlsDomMax": { "type": "int" }
      }
    },

    "get_entity_mortgages": {
      "_note": "fundingType is an ARRAY here (purchase/refinance/extension) while on the deed tools it is a single string (cash/financed).",
      "required": ["id"],
      "params": {
        "id": { "type": "uuid" },
        "page": { "type": "int" }, "perPage": { "type": "int", "min": 1, "max": 5000 },
        "scope": { "enum": ["data", "count", "totals"] },
        "sortBy": { "type": "string" }, "sortOrder": { "enum": ["asc", "desc"] },
        "state": { "type": "string[]" }, "city": { "type": "string[]" }, "countyName": { "type": "string[]" },
        "zipCode": { "type": "string[]" }, "region": { "type": "string[]" },
        "propertyTypes": { "type": "string[]" }, "propertySubtypes": { "type": "string[]" },
        "ids": { "type": "string[]" },
        "dateStart": { "type": "string" }, "dateEnd": { "type": "string" },
        "maturityStart": { "type": "string" }, "maturityEnd": { "type": "string" },
        "fundingType": { "type": "string[]" },
        "isBusinessPurpose": { "type": "boolean" }, "hasForeclosure": { "type": "boolean" },
        "lenderId": { "type": "string" }, "lenderType": { "type": "string[]" },
        "loanStatus": { "enum": ["open", "closed"] },
        "loanTermMin": { "type": "int" }, "loanTermMax": { "type": "int" },
        "amountMin": { "type": "number" }, "amountMax": { "type": "number" },
        "bounds": { "type": "string" },
        "mlsListingType": { "enum": ["sale", "rent"] },
        "mlsStatus": { "enum": ["sold", "active", "pending", "contingent", "off_market"] },
        "mlsPriceMin": { "type": "number" }, "mlsPriceMax": { "type": "number" },
        "mlsDomMin": { "type": "int" }, "mlsDomMax": { "type": "int" }
      }
    },

    "get_entity_associated_people": {
      "required": ["id"],
      "params": {
        "id": { "type": "uuid" },
        "page": { "type": "int" }, "perPage": { "type": "int", "min": 1, "max": 5000 },
        "scope": { "enum": ["data", "count"] }
      }
    },

    "get_entity_related_addresses": {
      "required": ["id"],
      "params": {
        "id": { "type": "uuid" },
        "page": { "type": "int" }, "perPage": { "type": "int", "min": 1, "max": 5000 },
        "scope": { "enum": ["data", "count"] }
      }
    },

    "get_entity_co_occurring_entities": {
      "required": ["id"],
      "params": {
        "id": { "type": "uuid" },
        "entityType": { "enum": ["COMPANY", "PERSON"] },
        "minSharedPrincipals": { "type": "int", "min": 1 },
        "page": { "type": "int" }, "perPage": { "type": "int", "min": 1, "max": 5000 },
        "scope": { "enum": ["data", "count"] }
      }
    },

    "get_address": {
      "required": ["id"],
      "params": {
        "id": { "type": "uuid" },
        "include": { "enum": ["metadata", "entities"] }
      }
    },

    "get_address_ownership": {
      "required": ["id"],
      "params": {
        "id": { "type": "uuid" },
        "page": { "type": "int" }, "perPage": { "type": "int", "min": 1, "max": 5000 },
        "scope": { "enum": ["data", "count"] },
        "sortBy": { "enum": ["startDate", "endDate", "totalConsideration"] },
        "sortOrder": { "enum": ["asc", "desc"] }
      }
    },

    "get_address_transactions": {
      "required": ["id"],
      "params": {
        "id": { "type": "uuid" },
        "documentType": { "enum": ["mortgage", "deed", "satisfaction", "assignment", "preforeclosure", "mechanics_lien"] },
        "startDate": { "type": "string" }, "endDate": { "type": "string" },
        "page": { "type": "int" }, "perPage": { "type": "int", "min": 1, "max": 5000 },
        "scope": { "enum": ["data", "count"] },
        "sortBy": { "enum": ["recordingDate"] },
        "sortOrder": { "enum": ["asc", "desc"] }
      }
    },

    "get_person_entities": {
      "required": ["id"],
      "params": {
        "id": { "type": "uuid" },
        "ids": { "type": "string[]" },
        "page": { "type": "int" }, "perPage": { "type": "int", "min": 1, "max": 5000 },
        "scope": { "enum": ["data", "count"] },
        "sortBy": { "type": "string" }, "sortOrder": { "enum": ["asc", "desc"] }
      }
    },

    "get_person_properties": {
      "required": ["id"],
      "params": {
        "id": { "type": "uuid" },
        "addressIds": { "type": "string[]" },
        "ownershipStatus": { "enum": ["all", "owned", "sold"] },
        "city": { "type": "string[]" }, "countyName": { "type": "string[]" },
        "zipCode": { "type": "string[]" }, "region": { "type": "string[]" },
        "considerationMin": { "type": "number" }, "considerationMax": { "type": "number" },
        "startDateFrom": { "type": "string" }, "startDateTo": { "type": "string" },
        "endDateFrom": { "type": "string" }, "endDateTo": { "type": "string" },
        "isBusinessPurpose": { "type": "boolean" },
        "bounds": { "type": "string" },
        "mlsListingType": { "enum": ["sale", "rent"] },
        "mlsStatus": { "enum": ["sold", "active", "pending", "contingent", "off_market"] },
        "mlsPriceMin": { "type": "number" }, "mlsPriceMax": { "type": "number" },
        "mlsDomMin": { "type": "int" }, "mlsDomMax": { "type": "int" },
        "page": { "type": "int" }, "perPage": { "type": "int", "min": 1, "max": 5000 },
        "scope": { "enum": ["data", "count"] },
        "sortBy": { "type": "string" }, "sortOrder": { "enum": ["asc", "desc"] }
      }
    },

    "get_person_deeds": {
      "required": ["id"],
      "params": {
        "id": { "type": "uuid" },
        "page": { "type": "int" }, "perPage": { "type": "int", "min": 1, "max": 5000 },
        "scope": { "enum": ["data", "count"] },
        "sortBy": { "type": "string" }, "sortOrder": { "enum": ["asc", "desc"] },
        "state": { "type": "string[]" }, "city": { "type": "string[]" }, "countyName": { "type": "string[]" },
        "zipCode": { "type": "string[]" }, "region": { "type": "string[]" },
        "propertyTypes": { "type": "string[]" }, "propertySubtypes": { "type": "string[]" },
        "ids": { "type": "string[]" },
        "dateStart": { "type": "string" }, "dateEnd": { "type": "string" },
        "fundingType": { "enum": ["cash", "financed"] },
        "isBusinessPurpose": { "type": "boolean" },
        "amountMin": { "type": "number" }, "amountMax": { "type": "number" },
        "bounds": { "type": "string" },
        "mlsListingType": { "enum": ["sale", "rent"] },
        "mlsStatus": { "enum": ["sold", "active", "pending", "contingent", "off_market"] },
        "mlsPriceMin": { "type": "number" }, "mlsPriceMax": { "type": "number" },
        "mlsDomMin": { "type": "int" }, "mlsDomMax": { "type": "int" }
      }
    },

    "get_person_mortgages": {
      "required": ["id"],
      "params": {
        "id": { "type": "uuid" },
        "page": { "type": "int" }, "perPage": { "type": "int", "min": 1, "max": 5000 },
        "scope": { "enum": ["data", "count", "totals"] },
        "sortBy": { "type": "string" }, "sortOrder": { "enum": ["asc", "desc"] },
        "state": { "type": "string[]" }, "city": { "type": "string[]" }, "countyName": { "type": "string[]" },
        "zipCode": { "type": "string[]" }, "region": { "type": "string[]" },
        "propertyTypes": { "type": "string[]" }, "propertySubtypes": { "type": "string[]" },
        "ids": { "type": "string[]" },
        "dateStart": { "type": "string" }, "dateEnd": { "type": "string" },
        "maturityStart": { "type": "string" }, "maturityEnd": { "type": "string" },
        "fundingType": { "type": "string[]" },
        "isBusinessPurpose": { "type": "boolean" }, "hasForeclosure": { "type": "boolean" },
        "lender": { "type": "string[]" }, "lenderType": { "type": "string[]" },
        "loanStatus": { "enum": ["open", "closed"] },
        "loanTermMin": { "type": "int" }, "loanTermMax": { "type": "int" },
        "amountMin": { "type": "number" }, "amountMax": { "type": "number" },
        "bounds": { "type": "string" },
        "mlsListingType": { "enum": ["sale", "rent"] },
        "mlsStatus": { "enum": ["sold", "active", "pending", "contingent", "off_market"] },
        "mlsPriceMin": { "type": "number" }, "mlsPriceMax": { "type": "number" },
        "mlsDomMin": { "type": "int" }, "mlsDomMax": { "type": "int" }
      }
    },

    "get_document": {
      "_note": "BOTH type and id are required, and the parameter is `id` — a request sent as {documentId} matches neither and is refused whole.",
      "required": ["type", "id"],
      "params": {
        "type": { "enum": ["mortgage", "deed", "satisfaction", "assignment", "preforeclosure", "mechanics_lien", "mechanics_lien_release", "tax_lien", "tax_lien_release"] },
        "id": { "type": "uuid" },
        "include": { "enum": ["metadata", "addresses", "signers"] }
      }
    },

    "get_coverage": {
      "_note": "state is an ARRAY of codes; there is NO county parameter — pick the county out of the state's rows client-side.",
      "required": [],
      "params": {
        "state": { "type": "string[]" },
        "status": { "type": "string[]" },
        "page": { "type": "int" }, "perPage": { "type": "int", "min": 1, "max": 5000 },
        "scope": { "enum": ["data", "count", "totals"] },
        "sortBy": { "type": "string" }, "sortOrder": { "enum": ["asc", "desc"] }
      }
    },

    "get_contact_status": {
      "required": ["personId"],
      "params": { "personId": { "type": "uuid" } }
    },

    "get_contact_info": {
      "required": ["personId"],
      "params": { "personId": { "type": "uuid" } }
    }
  }
}
