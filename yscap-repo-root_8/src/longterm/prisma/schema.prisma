  @@unique([scope, investor, seq], map: "lt_ppe_cutover_ledger_seq_uk")
  @@index([scope, investor, seq], map: "lt_ppe_cutover_ledger_history_idx")
  @@map("lt_ppe_cutover_ledger")
}

model LtPpeCanarySchedule {
  id                 String   @id @default(uuid()) @db.Uuid
  scope              String   @default("company")
  investor           String   @default("")
  enabled            Boolean  @default(false)
