  @@index([scope, enabled], map: "lt_ppe_canary_schedule_enabled_idx")
  @@map("lt_ppe_canary_schedule")
}

// PPE RULE store (db/571) — the persistent home for eligibility / bound / pricing
// rules. `ratesheet.js` produces PRICING rules from lt_ppe_adjustment rows, and
// said in its own words that "eligibility/bound rules live in a later rule table";
// this is that table. One row per rule code within a (scope, investor, program),
// with the nullable anchors COALESCEd in the unique index so a house rule
// (investor_id / program_id NULL) still dedupes cleanly.
//
// `id` is a bigint identity, NOT a uuid, matching db/571 — lt_ppe_rule_suggestion
// references it, so the two must agree. investor_id / program_id are UUID because
// lt_ppe_investor.id (db/558) and lt_ppe_program.id (db/560) are.
model LtPpeRule {
  id              BigInt    @id @default(autoincrement())
  scope           String    @default("company")
  investorId      String?   @map("investor_id") @db.Uuid
  programId       String?   @map("program_id") @db.Uuid
  code            String
  kind            String    @default("eligibility")
  source          String    @default("overlay")
  predicate       Json?     @db.JsonB
  declineReason   String?   @map("decline_reason")
  boundTarget     String?   @map("bound_target")
  boundOp         String?   @map("bound_op")
  boundValue      Decimal?  @map("bound_value") @db.Decimal
  adjustment      Json?     @db.JsonB
  priority        Int       @default(0)
  description     String?
  active          Boolean   @default(true)
  origin          String    @default("manual")
  lpDeclineReason String?   @map("lp_decline_reason")
  effectiveFrom   DateTime  @default(now()) @map("effective_from") @db.Timestamptz(6)
  effectiveTo     DateTime? @map("effective_to") @db.Timestamptz(6)
  createdBy       String?   @map("created_by")
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([scope, investorId, programId], map: "lt_ppe_rule_lookup_idx")
  @@map("lt_ppe_rule")
}

// PPE RULE SUGGESTION store (db/571) — the PROPOSAL half, and never auto-applied.
// The manual-review engine reads Lender Price's declines and SUGGESTS a rule per
// investor; a human accepts one, which writes an LtPpeRule and links it back
// through `created_rule_id`. `dedupe_key` is the analysis' distinct identity
// (adjType|reasonText) so re-running the review never duplicates a proposal, and a
// reason the crosswalk cannot map is stored with `predicate` NULL +
// `needs_human = true` — surfaced for a person, never guessed at.
model LtPpeRuleSuggestion {
  id            BigInt    @id @default(autoincrement())
  scope         String    @default("company")
  investorId    String?   @map("investor_id") @db.Uuid
  investorLabel String    @map("investor_label")
  dedupeKey     String    @map("dedupe_key")
  code          String
  kind          String    @default("eligibility")
  source        String    @default("overlay")
  predicate     Json?     @db.JsonB
  declineReason String    @map("decline_reason")
  adjType       String?   @map("adj_type")
  fact          String?
  confidence    String?
  matchedBy     String?   @map("matched_by")
  needsHuman    Boolean   @default(false) @map("needs_human")
  programs      Json      @default("[]") @db.JsonB
  occurrences   Int       @default(1)
  status        String    @default("open")
  createdRuleId BigInt?   @map("created_rule_id")
  decidedBy     String?   @map("decided_by")
  decidedAt     DateTime? @map("decided_at") @db.Timestamptz(6)
  decisionNote  String?   @map("decision_note")
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@unique([scope, investorLabel, dedupeKey], map: "lt_ppe_rule_suggestion_uk")
  @@map("lt_ppe_rule_suggestion")
}

/// Which PILOT borrower profile an Encompass borrower EMAIL belongs to (db/573).
///
/// The borrower twin of `LtStaffLink`, and it follows the same owner-directed rule:
/// PILOT proposes a match by email and a HUMAN confirms it. Keyed on the ADDRESS
/// rather than on a loan, because a borrower has many long-term loans and
/// confirming the same person once per loan is not a workflow anybody finishes —
/// so one decision governs every loan carrying that address, and a REJECTION is
/// just as durable as a confirmation.
model LtBorrowerLink {
  /// The normalised (lowercased) Encompass borrower email.
  encompassEmail String @id @map("encompass_email")

  /// The authorized `sql-ref borrowers`. ON DELETE SET NULL, and NULL is also the
  /// state of a rejection — enforced by `lt_borrower_links_status_chk`, so a
  /// refusal can never be mistaken for a link.
  borrowerId String? @map("borrower_id") @db.Uuid

  status LtLinkStatus @default(suggested)

  /// How the pair was proposed: 'email' or 'manual'.
  matchMethod String? @map("match_method")

  /// The name Encompass carried on the loan when the link was made, so the screen
  /// can still show what was decided after Encompass is re-read and the spelling
  /// moves.
  encompassName String? @map("encompass_name")

  confirmedBy String?   @map("confirmed_by") @db.Uuid
  confirmedAt DateTime? @map("confirmed_at") @db.Timestamptz(6)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  /// Deliberately NOT unique: a borrower legitimately has more than one address —
  /// a personal one and an entity one — and both are the same human, so refusing
  /// the second would make the true state unrecordable.
  @@index([borrowerId])
  @@index([status])
  @@map("lt_borrower_links")
}

// ════════════════════════════════════════════════════════════════════════════
// THE CONDITION CENTER'S MIRROR — conditions and the eFolder (db/612).
//
// Encompass is the source of truth; all five of these are a MIRROR, keyed on
// Encompass's own ids and stamped with when we last read them. Nothing here is
// ever written back: reading conditions and the eFolder is a READ, and the
// eFolder UPLOAD is a write that stays blocked until its request shape is
// verified on docs/ENCOMPASS-WRITE-AUTHORIZATIONS.md.
//
// The shape follows what was MEASURED rather than what the phrase "condition
// centre" usually implies: every condition in this tenant sits on a loan that is
// already closed and sold, so these are investor POST-PURCHASE conditions, while
// the live day-to-day work happens in the eFolder. Both are mirrored, and the
// file decides which face it shows.
// ════════════════════════════════════════════════════════════════════════════

/// One Encompass ENHANCED condition, mirrored.
///
/// Read from `GET /encompass/v3/loans/{id}/conditions` — never the four v1
/// condition routes, which answer 200 with an empty array on every loan here and
/// would read as "no conditions" on a file that plainly has them.
model LtCondition {
  id     String @id @default(uuid()) @db.Uuid
  loanId String @map("loan_id") @db.Uuid

  /// Encompass's condition GUID. This, with the loan, IS the identity of the row.
  encompassConditionId String @map("encompass_condition_id")

  /// All TEXT, not enums. 197 condition templates and 19 condition sets were
  /// counted in this tenant: the vocabulary is a buyer's configuration, and an
  /// enum would be a migration every time somebody spells their workflow
  /// differently — the same reasoning that keeps LtLoanContact.role text.
  conditionType       String? @map("condition_type")
  title               String?
  internalDescription String? @map("internal_description")
  /// What the borrower / TPO sees. The one to surface outward — and the investor
  /// name rule still applies to it in full.
  externalDescription String? @map("external_description")
  category            String?
  /// The gate it blocks: Approval | Docs | Funding | Closing | Submittal | Purchase.
  priorTo             String? @map("prior_to")

  status String?

  /// MIRRORED, NEVER DERIVED. Encompass computes whether a condition is still
  /// outstanding; deriving our own from the status word is how our screen ends up
  /// disagreeing with theirs about the same condition.
  statusOpen Boolean?  @map("status_open")
  statusDate DateTime? @map("status_date") @db.Timestamptz(6)

  source            String?
  sourceOfCondition String? @map("source_of_condition")
  printDefinitions  Json?   @map("print_definitions")
  /// Which borrower pair it belongs to ('All' for file-level).
  applicationRef    String? @map("application_ref")
  ownerRole         String? @map("owner_role")
  assignedTo        String? @map("assigned_to")
  recipient         String?
  daysToReceive     Int?    @map("days_to_receive")
  commentsCount     Int?    @map("comments_count")
  /// The template's short code, e.g. 'UW'.
  internalId        String? @map("internal_id")

  /// Soft-deleted upstream. Mirrored and filtered on READ, never deleted here —
  /// the record of what was once asked for is part of the story of the loan.
  isRemoved Boolean @default(false) @map("is_removed")

  encompassCreatedBy  String?   @map("encompass_created_by")
  encompassCreatedAt  DateTime? @map("encompass_created_at") @db.Timestamptz(6)
  encompassModifiedBy String?   @map("encompass_modified_by")
  encompassModifiedAt DateTime? @map("encompass_modified_at") @db.Timestamptz(6)

  /// The whole condition as Encompass sent it. A mirror that keeps only the
  /// fields today's screen reads cannot answer tomorrow's question without
  /// re-reading the tenant.
  raw Json?

  encompassSyncedAt DateTime? @map("encompass_synced_at") @db.Timestamptz(6)
  createdAt         DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  loan     LtLoan @relation(fields: [loanId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  comments LtConditionComment[]
  documentLinks LtDocumentCondition[]

  @@unique([loanId, encompassConditionId])
  @@index([loanId])
  @@map("lt_conditions")
}

/// The thread on one condition. Its own table rather than a blob on the
/// condition, because a comment is the unit a person reads and answers.
model LtConditionComment {
  id                 String  @id @default(uuid()) @db.Uuid
  conditionId        String  @map("condition_id") @db.Uuid
  encompassCommentId String? @map("encompass_comment_id")

  body        String?
  authorName  String?   @map("author_name")
  authorId    String?   @map("author_id")
  commentedAt DateTime? @map("commented_at") @db.Timestamptz(6)

  raw               Json?
  encompassSyncedAt DateTime? @map("encompass_synced_at") @db.Timestamptz(6)
  createdAt         DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  condition LtCondition @relation(fields: [conditionId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  /// PARTIAL in the migration (only where the id is present): a comment id is not
  /// guaranteed on every payload, and a blanket unique over a nullable column
  /// would collapse two real comments that both arrive without one.
  @@unique([conditionId, encompassCommentId])
  @@index([conditionId, commentedAt])
  @@map("lt_condition_comments")
}

/// An eFolder DOCUMENT — the SLOT ("Appraisal"), not the paper.
///
/// 20,569 of these were counted across 673 loans, holding 28,822 attachments, so
/// one-document-many-attachments is the ordinary case rather than an edge one.
model LtDocument {
  id                  String @id @default(uuid()) @db.Uuid
  loanId              String @map("loan_id") @db.Uuid
  encompassDocumentId String @map("encompass_document_id")

  title          String?
  titleWithIndex String? @map("title_with_index")
  applicationRef String? @map("application_ref")
  applicationName String? @map("application_name")
  milestoneId    String? @map("milestone_id")
  milestoneName  String? @map("milestone_name")

  /// The eFolder's own vocabulary — needed / received / ordered / reordered /
  /// expected / expected! / expired! / ready to ship / ready for UW / reviewed.
  /// Mirrored verbatim: the moment we translate it into our own words, our screen
  /// and theirs can disagree about the same document.
  status String?

  roles Json?

  /// What Encompass believes about who may see this document. Mirrored as a FACT,
  /// never used as an authorization here — long-term access is decided by
  /// src/longterm/access.js.
  webCenterAllowed  Boolean? @map("web_center_allowed")
  tpoAllowed        Boolean? @map("tpo_allowed")
  thirdPartyAllowed Boolean? @map("third_party_allowed")
  isProtected       Boolean? @map("is_protected")

  daysDue         Int? @map("days_due")
  daysTillExpire  Int? @map("days_till_expire")
  attachmentCount Int? @map("attachment_count")

  isRemoved Boolean @default(false) @map("is_removed")

  encompassCreatedBy String?   @map("encompass_created_by")
  encompassCreatedAt DateTime? @map("encompass_created_at") @db.Timestamptz(6)

  raw               Json?
  encompassSyncedAt DateTime? @map("encompass_synced_at") @db.Timestamptz(6)
  createdAt         DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  loan           LtLoan @relation(fields: [loanId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  attachments    LtDocumentAttachment[]
  conditionLinks LtDocumentCondition[]

  @@unique([loanId, encompassDocumentId])
  @@index([loanId])
  @@map("lt_documents")
}

/// The paper — METADATA ONLY. We keep the URI, never the bytes: Encompass is the
/// system of record for the file itself, a copy starts drifting the moment
/// somebody replaces the original there, and pulling borrower paper into a second
/// store is a decision about where PII lives that nobody has asked for.
model LtDocumentAttachment {
  id                    String @id @default(uuid()) @db.Uuid
  documentId            String @map("document_id") @db.Uuid
  encompassAttachmentId String @map("encompass_attachment_id")

  title       String?
  fileName    String? @map("file_name")
  contentType String? @map("content_type")
  fileSize    BigInt? @map("file_size")
  pageCount   Int?    @map("page_count")

  /// A POINTER. Reading it later is a fresh authenticated GET, exactly as it is
  /// today — never a copy of the document sitting in our database.
  encompassUri String? @map("encompass_uri")

  isRemoved Boolean @default(false) @map("is_removed")

  encompassCreatedBy String?   @map("encompass_created_by")
  encompassCreatedAt DateTime? @map("encompass_created_at") @db.Timestamptz(6)

  raw               Json?
  encompassSyncedAt DateTime? @map("encompass_synced_at") @db.Timestamptz(6)
  createdAt         DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  document LtDocument @relation(fields: [documentId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@unique([documentId, encompassAttachmentId])
  @@index([documentId])
  @@map("lt_document_attachments")
}

/// THE INVERTED LINK. The link lives on the DOCUMENT (`document.conditions[]`)
/// and Encompass exposes no condition->documents endpoint, so "which documents
/// satisfy this condition" is built by inverting the mapping — a many-to-many,
/// and therefore a table rather than a column on either side.
model LtDocumentCondition {
  id         String @id @default(uuid()) @db.Uuid
  documentId String @map("document_id") @db.Uuid

  /// THE LINK ITSELF. Encompass can name a condition we have not mirrored yet —
  /// the two reads are separate calls that can land in either order, and a removed
  /// condition is still referenced by the documents that answered it. Keying on
  /// the Encompass id records the FACT whatever we happen to hold.
  encompassConditionId String @map("encompass_condition_id")

  /// Only the RESOLUTION of that fact, filled in when the condition row exists.
  /// SET NULL rather than cascade, for the same reason.
  conditionId String? @map("condition_id") @db.Uuid

  entityType String? @map("entity_type")
  entityName String? @map("entity_name")
  entityUri  String? @map("entity_uri")

  encompassSyncedAt DateTime? @map("encompass_synced_at") @db.Timestamptz(6)
  createdAt         DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  document  LtDocument   @relation(fields: [documentId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  condition LtCondition? @relation(fields: [conditionId], references: [id], onDelete: SetNull, onUpdate: Cascade)

  @@unique([documentId, encompassConditionId])
  @@index([conditionId])
  @@map("lt_document_conditions")
}

/// WHAT EVERY SYNC PASS ACTUALLY DID — so an empty book can say why (db/616).
///
/// `GET /api/lt/sync` builds its whole answer out of `lt_loans`: how many rows, how
/// many were read, how many carry an error. That is a fine report on loans we HAVE
/// and says nothing at all about a pass that never got a loan — a refused login, an
/// Encompass outage, a search that answered with an empty list, the feature switched
/// off. Every one of those rendered identically to "Encompass has nothing for us".
/// A report built only from the rows a job PRODUCED can never explain a job that
/// produced none, so this records the RUN rather than its output.
///
/// A LOG, not a single current-state row: "it is failing right now" and "it has been
/// failing since Tuesday" are different facts, and the second is the one that tells
/// somebody whether an outage explains an empty book. Pruned by its own writer
/// (newest N per kind), so it is bounded without a scheduled job.
model LtSyncRun {
  id String @id @default(uuid()) @db.Uuid

  /// Which pass: loans | conditions | milestone_catalog | pilot_roles. Deliberately
  /// free text rather than an enum — a pass added later must be able to record
  /// itself without a migration, and the cost of an unrecognised kind is a row the
  /// screen groups under its own name, never a lost write on the one table whose job
  /// is to explain a failure.
  kind String

  /// 'worker' (the timer) or 'manual' (somebody pressed the button). "The button did
  /// nothing" and "the timer has not run" send you to two different places.
  trigger String @default("worker")

  startedAt DateTime @default(now()) @map("started_at") @db.Timestamptz(6)

  /// NULL while a pass is still running. A row that never gains a finish IS the
  /// record of a pass that died mid-flight, which no summary count could show.
  finishedAt DateTime? @map("finished_at") @db.Timestamptz(6)

  ok Boolean?

  /// WHY, in the words a person reads. Filled on a refusal or a failure and left
  /// NULL on a clean pass — a reason on a successful run would train people to
  /// ignore the column.
  reason String?

  discovered Int?
  readCount  Int? @map("read_count")
  failed     Int?

  /// Loans deliberately not mirrored — today, files the product rule proved are
  /// short-term and belong to the other product.
  skipped   Int?
  remaining Int?
  passes    Int?

  /// The pass's own shape, verbatim, so a question nobody thought to ask today is
  /// still answerable from what was captured — today, WHICH loans the database
  /// refused.
  detail Json?

  /// The only question ever asked of this table: "what did the last pass of this
  /// kind do?"
  @@index([kind, startedAt(sort: Desc)], map: "lt_sync_runs_kind_started_idx")
  @@map("lt_sync_runs")
}


/// EVERY TIME A LONG-TERM LOAN GAINED, CHANGED, LOST OR STAMPED ITS CLICKUP CARD
/// (db/618). The loan row holds the CURRENT answer; this holds how it got there.
///
/// It exists because a link that changes silently is the one thing that could
/// quietly re-point a deal at somebody else's card, and the loan row alone can
/// never answer "who tied these two together, and what did they match on?".
model LtClickupLinkLog {
  id       String @id @default(uuid()) @db.Uuid
  ltLoanId String @map("lt_loan_id") @db.Uuid

  /// linked | relinked | unlinked | confirmed | stamped | stamp_failed. Free text
  /// for the same reason LtSyncRun.kind is: a new action must be able to record
  /// itself without a migration, and an unrecognised one costs a row grouped under
  /// its own name, never a lost write on the table whose job is to explain.
  action String

  fromTaskId String? @map("from_task_id")
  toTaskId   String? @map("to_task_id")
  confidence String?
  source     String?

  /// Plain language: what it was matched on, or what refused. Read by a person.
  reason String?

  /// The staff_users row that did it. NULL for a pass PILOT ran on its own.
  actedBy String? @map("acted_by") @db.Uuid

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([ltLoanId, createdAt(sort: Desc)], map: "lt_clickup_link_log_loan_idx")
  @@map("lt_clickup_link_log")
}
