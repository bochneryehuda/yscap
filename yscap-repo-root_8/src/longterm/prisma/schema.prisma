  @@map("lt_ppe_canary_schedule")
}

// PPE RULE store (db/571) — the persistent home for eligibility / bound / pricing
// rules. `ratesheet.js` produces PRICING rules from lt_ppe_adjustment rows, and
// said in its own words that "eligibility/bound rules live in a later rule table";
// this is that table. One row per rule code within a (scope, investor, program),
// with the nullable anchors COALESCEd in the unique index so a house rule
// (investor_id / program_id NULL) still dedupes cleanly.
//
// `id` is a bigint identity, NOT a uuid, matching db/571 — lt_ppe_rule_suggestion
// references it, so the two must agree. investor_id / program_id are UUID because
// lt_ppe_investor.id (db/558) and lt_ppe_program.id (db/560) are.
model LtPpeRule {
  id              BigInt    @id @default(autoincrement())
  scope           String    @default("company")
  investorId      String?   @map("investor_id") @db.Uuid
  programId       String?   @map("program_id") @db.Uuid
  code            String
  kind            String    @default("eligibility")
  source          String    @default("overlay")
  predicate       Json?     @db.JsonB
  declineReason   String?   @map("decline_reason")
  boundTarget     String?   @map("bound_target")
  boundOp         String?   @map("bound_op")
  boundValue      Decimal?  @map("bound_value") @db.Decimal
  adjustment      Json?     @db.JsonB
  priority        Int       @default(0)
  description     String?
  active          Boolean   @default(true)
  origin          String    @default("manual")
  lpDeclineReason String?   @map("lp_decline_reason")
  effectiveFrom   DateTime  @default(now()) @map("effective_from") @db.Timestamptz(6)
  effectiveTo     DateTime? @map("effective_to") @db.Timestamptz(6)
  createdBy       String?   @map("created_by")
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([scope, investorId, programId], map: "lt_ppe_rule_lookup_idx")
  @@map("lt_ppe_rule")
}

// PPE RULE SUGGESTION store (db/571) — the PROPOSAL half, and never auto-applied.
// The manual-review engine reads Lender Price's declines and SUGGESTS a rule per
// investor; a human accepts one, which writes an LtPpeRule and links it back
// through `created_rule_id`. `dedupe_key` is the analysis' distinct identity
// (adjType|reasonText) so re-running the review never duplicates a proposal, and a
// reason the crosswalk cannot map is stored with `predicate` NULL +
// `needs_human = true` — surfaced for a person, never guessed at.
model LtPpeRuleSuggestion {
  id            BigInt    @id @default(autoincrement())
  scope         String    @default("company")
  investorId    String?   @map("investor_id") @db.Uuid
  investorLabel String    @map("investor_label")
  dedupeKey     String    @map("dedupe_key")
  code          String
  kind          String    @default("eligibility")
  source        String    @default("overlay")
  predicate     Json?     @db.JsonB
  declineReason String    @map("decline_reason")
  adjType       String?   @map("adj_type")
  fact          String?
  confidence    String?
  matchedBy     String?   @map("matched_by")
  needsHuman    Boolean   @default(false) @map("needs_human")
  programs      Json      @default("[]") @db.JsonB
  occurrences   Int       @default(1)
  status        String    @default("open")
  createdRuleId BigInt?   @map("created_rule_id")
  decidedBy     String?   @map("decided_by")
  decidedAt     DateTime? @map("decided_at") @db.Timestamptz(6)
  decisionNote  String?   @map("decision_note")
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@unique([scope, investorLabel, dedupeKey], map: "lt_ppe_rule_suggestion_uk")
  @@map("lt_ppe_rule_suggestion")
}

/// Which PILOT borrower profile an Encompass borrower EMAIL belongs to (db/573).
///
/// The borrower twin of `LtStaffLink`, and it follows the same owner-directed rule:
/// PILOT proposes a match by email and a HUMAN confirms it. Keyed on the ADDRESS
/// rather than on a loan, because a borrower has many long-term loans and
/// confirming the same person once per loan is not a workflow anybody finishes —
/// so one decision governs every loan carrying that address, and a REJECTION is
/// just as durable as a confirmation.
model LtBorrowerLink {
  /// The normalised (lowercased) Encompass borrower email.
  encompassEmail String @id @map("encompass_email")

  /// The authorized `sql-ref borrowers`. ON DELETE SET NULL, and NULL is also the
  /// state of a rejection — enforced by `lt_borrower_links_status_chk`, so a
  /// refusal can never be mistaken for a link.
  borrowerId String? @map("borrower_id") @db.Uuid

  status LtLinkStatus @default(suggested)

  /// How the pair was proposed: 'email' or 'manual'.
  matchMethod String? @map("match_method")

  /// The name Encompass carried on the loan when the link was made, so the screen
  /// can still show what was decided after Encompass is re-read and the spelling
  /// moves.
  encompassName String? @map("encompass_name")

  confirmedBy String?   @map("confirmed_by") @db.Uuid
  confirmedAt DateTime? @map("confirmed_at") @db.Timestamptz(6)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  /// Deliberately NOT unique: a borrower legitimately has more than one address —
  /// a personal one and an entity one — and both are the same human, so refusing
  /// the second would make the true state unrecordable.
  @@index([borrowerId])
  @@index([status])
  @@map("lt_borrower_links")
}

// ════════════════════════════════════════════════════════════════════════════
// THE CONDITION CENTER'S MIRROR — conditions and the eFolder (db/612).
//
// Encompass is the source of truth; all five of these are a MIRROR, keyed on
// Encompass's own ids and stamped with when we last read them. Nothing here is
// ever written back: reading conditions and the eFolder is a READ, and the
// eFolder UPLOAD is a write that stays blocked until its request shape is
// verified on docs/ENCOMPASS-WRITE-AUTHORIZATIONS.md.
//
// The shape follows what was MEASURED rather than what the phrase "condition
// centre" usually implies: every condition in this tenant sits on a loan that is
// already closed and sold, so these are investor POST-PURCHASE conditions, while
// the live day-to-day work happens in the eFolder. Both are mirrored, and the
// file decides which face it shows.
// ════════════════════════════════════════════════════════════════════════════

/// One Encompass ENHANCED condition, mirrored.
///
/// Read from `GET /encompass/v3/loans/{id}/conditions` — never the four v1
/// condition routes, which answer 200 with an empty array on every loan here and
/// would read as "no conditions" on a file that plainly has them.
model LtCondition {
  id     String @id @default(uuid()) @db.Uuid
  loanId String @map("loan_id") @db.Uuid

  /// Encompass's condition GUID. This, with the loan, IS the identity of the row.
  encompassConditionId String @map("encompass_condition_id")

  /// All TEXT, not enums. 197 condition templates and 19 condition sets were
  /// counted in this tenant: the vocabulary is a buyer's configuration, and an
  /// enum would be a migration every time somebody spells their workflow
  /// differently — the same reasoning that keeps LtLoanContact.role text.
  conditionType       String? @map("condition_type")
  title               String?
  internalDescription String? @map("internal_description")
  /// What the borrower / TPO sees. The one to surface outward — and the investor
  /// name rule still applies to it in full.
  externalDescription String? @map("external_description")
  category            String?
  /// The gate it blocks: Approval | Docs | Funding | Closing | Submittal | Purchase.
  priorTo             String? @map("prior_to")

  status String?

  /// MIRRORED, NEVER DERIVED. Encompass computes whether a condition is still
  /// outstanding; deriving our own from the status word is how our screen ends up
  /// disagreeing with theirs about the same condition.
  statusOpen Boolean?  @map("status_open")
  statusDate DateTime? @map("status_date") @db.Timestamptz(6)

  source            String?
  sourceOfCondition String? @map("source_of_condition")
  printDefinitions  Json?   @map("print_definitions")
  /// Which borrower pair it belongs to ('All' for file-level).
  applicationRef    String? @map("application_ref")
  ownerRole         String? @map("owner_role")
  assignedTo        String? @map("assigned_to")
  recipient         String?
  daysToReceive     Int?    @map("days_to_receive")
  commentsCount     Int?    @map("comments_count")
  /// The template's short code, e.g. 'UW'.
  internalId        String? @map("internal_id")

  /// Soft-deleted upstream. Mirrored and filtered on READ, never deleted here —
  /// the record of what was once asked for is part of the story of the loan.
  isRemoved Boolean @default(false) @map("is_removed")

  encompassCreatedBy  String?   @map("encompass_created_by")
  encompassCreatedAt  DateTime? @map("encompass_created_at") @db.Timestamptz(6)
  encompassModifiedBy String?   @map("encompass_modified_by")
  encompassModifiedAt DateTime? @map("encompass_modified_at") @db.Timestamptz(6)

  /// The whole condition as Encompass sent it. A mirror that keeps only the
  /// fields today's screen reads cannot answer tomorrow's question without
  /// re-reading the tenant.
  raw Json?

  encompassSyncedAt DateTime? @map("encompass_synced_at") @db.Timestamptz(6)
  createdAt         DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  loan     LtLoan @relation(fields: [loanId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  comments LtConditionComment[]
  documentLinks LtDocumentCondition[]

  @@unique([loanId, encompassConditionId])
  @@index([loanId])
  @@map("lt_conditions")
}

/// The thread on one condition. Its own table rather than a blob on the
/// condition, because a comment is the unit a person reads and answers.
model LtConditionComment {
  id                 String  @id @default(uuid()) @db.Uuid
  conditionId        String  @map("condition_id") @db.Uuid
  encompassCommentId String? @map("encompass_comment_id")

  body        String?
  authorName  String?   @map("author_name")
  authorId    String?   @map("author_id")
  commentedAt DateTime? @map("commented_at") @db.Timestamptz(6)

  raw               Json?
  encompassSyncedAt DateTime? @map("encompass_synced_at") @db.Timestamptz(6)
  createdAt         DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  condition LtCondition @relation(fields: [conditionId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  /// PARTIAL in the migration (only where the id is present): a comment id is not
  /// guaranteed on every payload, and a blanket unique over a nullable column
  /// would collapse two real comments that both arrive without one.
  @@unique([conditionId, encompassCommentId])
  @@index([conditionId, commentedAt])
  @@map("lt_condition_comments")
}

/// An eFolder DOCUMENT — the SLOT ("Appraisal"), not the paper.
///
/// 20,569 of these were counted across 673 loans, holding 28,822 attachments, so
/// one-document-many-attachments is the ordinary case rather than an edge one.
model LtDocument {
  id                  String @id @default(uuid()) @db.Uuid
  loanId              String @map("loan_id") @db.Uuid
  encompassDocumentId String @map("encompass_document_id")

  title          String?
  titleWithIndex String? @map("title_with_index")
  applicationRef String? @map("application_ref")
  applicationName String? @map("application_name")
  milestoneId    String? @map("milestone_id")
  milestoneName  String? @map("milestone_name")

  /// The eFolder's own vocabulary — needed / received / ordered / reordered /
  /// expected / expected! / expired! / ready to ship / ready for UW / reviewed.
  /// Mirrored verbatim: the moment we translate it into our own words, our screen
  /// and theirs can disagree about the same document.
  status String?

  roles Json?

  /// What Encompass believes about who may see this document. Mirrored as a FACT,
  /// never used as an authorization here — long-term access is decided by
  /// src/longterm/access.js.
  webCenterAllowed  Boolean? @map("web_center_allowed")
  tpoAllowed        Boolean? @map("tpo_allowed")
  thirdPartyAllowed Boolean? @map("third_party_allowed")
  isProtected       Boolean? @map("is_protected")

  daysDue         Int? @map("days_due")
  daysTillExpire  Int? @map("days_till_expire")
  attachmentCount Int? @map("attachment_count")

  isRemoved Boolean @default(false) @map("is_removed")

  encompassCreatedBy String?   @map("encompass_created_by")
  encompassCreatedAt DateTime? @map("encompass_created_at") @db.Timestamptz(6)

  raw               Json?
  encompassSyncedAt DateTime? @map("encompass_synced_at") @db.Timestamptz(6)
  createdAt         DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  loan           LtLoan @relation(fields: [loanId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  attachments    LtDocumentAttachment[]
  conditionLinks LtDocumentCondition[]

  @@unique([loanId, encompassDocumentId])
  @@index([loanId])
  @@map("lt_documents")
}

/// The paper — METADATA ONLY. We keep the URI, never the bytes: Encompass is the
/// system of record for the file itself, a copy starts drifting the moment
/// somebody replaces the original there, and pulling borrower paper into a second
/// store is a decision about where PII lives that nobody has asked for.
model LtDocumentAttachment {
  id                    String @id @default(uuid()) @db.Uuid
  documentId            String @map("document_id") @db.Uuid
  encompassAttachmentId String @map("encompass_attachment_id")

  title       String?
  fileName    String? @map("file_name")
  contentType String? @map("content_type")
  fileSize    BigInt? @map("file_size")
  pageCount   Int?    @map("page_count")

  /// A POINTER. Reading it later is a fresh authenticated GET, exactly as it is
  /// today — never a copy of the document sitting in our database.
  encompassUri String? @map("encompass_uri")

  isRemoved Boolean @default(false) @map("is_removed")

  encompassCreatedBy String?   @map("encompass_created_by")
  encompassCreatedAt DateTime? @map("encompass_created_at") @db.Timestamptz(6)

  raw               Json?
  encompassSyncedAt DateTime? @map("encompass_synced_at") @db.Timestamptz(6)
  createdAt         DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  document LtDocument @relation(fields: [documentId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@unique([documentId, encompassAttachmentId])
  @@index([documentId])
  @@map("lt_document_attachments")
}

/// THE INVERTED LINK. The link lives on the DOCUMENT (`document.conditions[]`)
/// and Encompass exposes no condition->documents endpoint, so "which documents
/// satisfy this condition" is built by inverting the mapping — a many-to-many,
/// and therefore a table rather than a column on either side.
model LtDocumentCondition {
  id         String @id @default(uuid()) @db.Uuid
  documentId String @map("document_id") @db.Uuid

  /// THE LINK ITSELF. Encompass can name a condition we have not mirrored yet —
  /// the two reads are separate calls that can land in either order, and a removed
  /// condition is still referenced by the documents that answered it. Keying on
  /// the Encompass id records the FACT whatever we happen to hold.
  encompassConditionId String @map("encompass_condition_id")

  /// Only the RESOLUTION of that fact, filled in when the condition row exists.
  /// SET NULL rather than cascade, for the same reason.
  conditionId String? @map("condition_id") @db.Uuid

  entityType String? @map("entity_type")
  entityName String? @map("entity_name")
  entityUri  String? @map("entity_uri")

  encompassSyncedAt DateTime? @map("encompass_synced_at") @db.Timestamptz(6)
  createdAt         DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  document  LtDocument   @relation(fields: [documentId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  condition LtCondition? @relation(fields: [conditionId], references: [id], onDelete: SetNull, onUpdate: Cascade)

  @@unique([documentId, encompassConditionId])
  @@index([conditionId])
  @@map("lt_document_conditions")
}

/// WHAT EVERY SYNC PASS ACTUALLY DID — so an empty book can say why (db/616).
///
/// `GET /api/lt/sync` builds its whole answer out of `lt_loans`: how many rows, how
/// many were read, how many carry an error. That is a fine report on loans we HAVE
/// and says nothing at all about a pass that never got a loan — a refused login, an
/// Encompass outage, a search that answered with an empty list, the feature switched
/// off. Every one of those rendered identically to "Encompass has nothing for us".
/// A report built only from the rows a job PRODUCED can never explain a job that
/// produced none, so this records the RUN rather than its output.
///
/// A LOG, not a single current-state row: "it is failing right now" and "it has been
/// failing since Tuesday" are different facts, and the second is the one that tells
/// somebody whether an outage explains an empty book. Pruned by its own writer
/// (newest N per kind), so it is bounded without a scheduled job.
model LtSyncRun {
  id String @id @default(uuid()) @db.Uuid

  /// Which pass: loans | conditions | milestone_catalog | pilot_roles. Deliberately
  /// free text rather than an enum — a pass added later must be able to record
  /// itself without a migration, and the cost of an unrecognised kind is a row the
  /// screen groups under its own name, never a lost write on the one table whose job
  /// is to explain a failure.
  kind String

  /// 'worker' (the timer) or 'manual' (somebody pressed the button). "The button did
  /// nothing" and "the timer has not run" send you to two different places.
  trigger String @default("worker")

  startedAt DateTime @default(now()) @map("started_at") @db.Timestamptz(6)

  /// NULL while a pass is still running. A row that never gains a finish IS the
  /// record of a pass that died mid-flight, which no summary count could show.
  finishedAt DateTime? @map("finished_at") @db.Timestamptz(6)

  ok Boolean?

  /// WHY, in the words a person reads. Filled on a refusal or a failure and left
  /// NULL on a clean pass — a reason on a successful run would train people to
  /// ignore the column.
  reason String?

  discovered Int?
  readCount  Int? @map("read_count")
  failed     Int?

  /// Loans deliberately not mirrored — today, files the product rule proved are
  /// short-term and belong to the other product.
  skipped   Int?
  remaining Int?
  passes    Int?

  /// The pass's own shape, verbatim, so a question nobody thought to ask today is
  /// still answerable from what was captured — today, WHICH loans the database
  /// refused.
  detail Json?

  /// The only question ever asked of this table: "what did the last pass of this
  /// kind do?"
  @@index([kind, startedAt(sort: Desc)], map: "lt_sync_runs_kind_started_idx")
  @@map("lt_sync_runs")
}


/// EVERY TIME A LONG-TERM LOAN GAINED, CHANGED, LOST OR STAMPED ITS CLICKUP CARD
/// (db/618). The loan row holds the CURRENT answer; this holds how it got there.
///
/// It exists because a link that changes silently is the one thing that could
/// quietly re-point a deal at somebody else's card, and the loan row alone can
/// never answer "who tied these two together, and what did they match on?".
model LtClickupLinkLog {
  id       String @id @default(uuid()) @db.Uuid
  ltLoanId String @map("lt_loan_id") @db.Uuid

  /// linked | relinked | unlinked | confirmed | stamped | stamp_failed. Free text
  /// for the same reason LtSyncRun.kind is: a new action must be able to record
  /// itself without a migration, and an unrecognised one costs a row grouped under
  /// its own name, never a lost write on the table whose job is to explain.
  action String

  fromTaskId String? @map("from_task_id")
  toTaskId   String? @map("to_task_id")
  confidence String?
  source     String?

  /// Plain language: what it was matched on, or what refused. Read by a person.
  reason String?

  /// The staff_users row that did it. NULL for a pass PILOT ran on its own.
  actedBy String? @map("acted_by") @db.Uuid

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([ltLoanId, createdAt(sort: Desc)], map: "lt_clickup_link_log_loan_idx")
  @@map("lt_clickup_link_log")
}

/// db/625 — the ClickUp field writer's JOURNAL: every outbound field write,
/// before + after values (SSN masked BEFORE insert — a readable Social never
/// lands here), including writes a guardrail refused (blocked=true). Append-
/// only and best-effort: a journal failure never blocks a push. The volume
/// circuit breaker seeds its rolling 10-minute window from this table on boot,
/// so a restart mid-storm cannot reset the budget.
model LtClickupWriteLog {
  id       BigInt  @id @default(autoincrement())
  ltLoanId String? @map("lt_loan_id") @db.Uuid
  taskId   String  @map("task_id")
  /// NULL for a non-field event (e.g. a refused short-term card).
  fieldId  String? @map("field_id")
  /// The mapper's logical key ('ssn', 'loan_amount', …).
  fieldKey String? @map("field_key")
  /// ClickUp's value immediately before (NULL = unknown / a brand-new card).
  oldValue Json?   @map("old_value")
  /// What we wrote — or tried to, or were refused to.
  newValue Json?   @map("new_value")
  /// false = nothing landed on the card.
  changed  Boolean @default(true)
  /// true = a guardrail refused it (PII shield, DOB gate, wire failure).
  blocked  Boolean @default(false)
  /// 'create' | 'scoped_push' | 'full_repush'
  source   String?
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([taskId, createdAt(sort: Desc)], map: "lt_cu_write_log_task_idx")
  @@index([ltLoanId, createdAt(sort: Desc)], map: "lt_cu_write_log_loan_idx")
  @@map("lt_clickup_write_log")
}

/// db/625 — outbound ClickUp writes a guardrail held for a PERSON: a differing
/// identity field a push may only FILL (pii_overwrite_blocked), or a change to
/// an existing ClickUp DOB (dob_change_blocked_pending_review). Values arrive
/// MASKED — an SSN is never stored here. One OPEN row per (task, field,
/// proposal) — the partial unique index dedupes a retried pass. Resolving one
/// re-pushes the single field with approvedReview; rejecting keeps the card.
model LtClickupReviewQueue {
  id            BigInt  @id @default(autoincrement())
  ltLoanId      String? @map("lt_loan_id") @db.Uuid
  taskId        String  @map("task_id")
  direction     String  @default("outbound")
  fieldKey      String  @map("field_key")
  /// What the card holds (masked where PII).
  currentValue  String? @map("current_value")
  /// What the mirror wanted to write (masked).
  proposedValue String? @map("proposed_value")
  reason        String
  /// 'open' | 'resolved' | 'rejected' (CHECK lt_cu_review_status_chk)
  status        String  @default("open")
  resolvedBy    String?   @map("resolved_by") @db.Uuid
  resolvedAt    DateTime? @map("resolved_at") @db.Timestamptz(6)
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([ltLoanId, createdAt(sort: Desc)], map: "lt_cu_review_loan_idx")
  @@map("lt_clickup_review_queue")
}

/// db/642 — A TERM SHEET IS WRITE-ONCE, AND ITS ID IS THE PROMISE.
///
/// The owner: *"every term sheet that you export should have a term sheet ID,
/// and every loan officer can go to their pull up term sheet and put in the term
/// sheet ID and pull up the exact scenario that was searched."* So the whole row
/// is frozen at issue: the `snapshot` is the document, `snapshotHash` is what
/// makes a replay able to say it IS the document rather than merely resemble it,
/// and a correction is a NEW sheet naming the one it replaces.
///
/// `mode` is 'borrowerPaid' | 'lenderPaid' and NEVER 'raw' — the CHECK is the
/// last of three layers under the owner's *"raw pricing should not be able to
/// export term sheets"*. It describes the FIRST option only; each member carries
/// its own, because the owner's three offers put borrower-paid and lender-paid
/// side by side on one sheet.
model LtTermSheet {
  id              String  @id @default(uuid()) @db.Uuid
  /// TS-4K7P2M. Unique on upper(code), so it resolves however it is typed.
  code            String
  borrowerId      String? @map("borrower_id") @db.Uuid
  borrowerName    String? @map("borrower_name")
  createdByStaff  String? @map("created_by_staff") @db.Uuid
  /// 'officer' | 'borrower' (CHECK lt_term_sheet_created_by_chk)
  createdBy       String  @default("officer") @map("created_by")
  /// 'borrowerPaid' | 'lenderPaid' (CHECK lt_term_sheet_mode_chk)
  mode            String
  waiveLenderFees Boolean @default(false) @map("waive_lender_fees")
  /// 'single' | 'comparison' (CHECK lt_term_sheet_kind_chk)
  kind            String  @default("single")
  /// The compensation the figures were derived from, as the server resolved it.
  compPlan        Json    @default("{}") @map("comp_plan") @db.JsonB
  /// The document itself. Consumer-safe by construction — snapshot.js is a
  /// WHITELIST, so no investor, lender or rate-sheet key exists on it.
  snapshot        Json    @default("{}") @db.JsonB
  snapshotHash    String  @map("snapshot_hash")
  /// The sheet this one replaces. Never an edit — the record keeps both.
  supersedes      String? @db.Uuid

  pricedAt  DateTime @default(now()) @map("priced_at") @db.Timestamptz(6)
  expiresAt DateTime @map("expires_at") @db.Timestamptz(6)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([createdByStaff, createdAt(sort: Desc)], map: "lt_term_sheet_staff_idx")
  @@index([borrowerId, createdAt(sort: Desc)], map: "lt_term_sheet_borrower_idx")
  @@map("lt_term_sheet")
}

/// db/642 — ONE OPEN COMPARISON PER OFFICER.
///
/// The owner: *"you can do one search and click start comparison. You check mark
/// two programs from that search, and then you go back into another search."*
/// The unique index on staffId is what makes the second search add to the SAME
/// comparison rather than open a rival one.
model LtTermSheetCart {
  id             String  @id @default(uuid()) @db.Uuid
  staffId        String? @map("staff_id") @db.Uuid
  /// Which option everything else is compared against. One anchor, always.
  anchorPosition Int     @default(0) @map("anchor_position")
// ============================================================================
// THE GENERAL CONDITION CENTER (db/643).
//
// DELIBERATELY SEPARATE FROM `LtCondition` / `LtDocument` (db/612), which are
// ENCOMPASS'S conditions and eFolder, mirrored. Those rows are keyed on
// Encompass's own ids and must be safe to delete and re-read at any time; these
// carry a human's sign-off, their note and the documents they uploaded, and the
// next mirror pass would destroy them. One table for both would also make "is
// this ours or theirs?" a column somebody has to remember to filter on.
//
// Everything below is a ROW rather than a constant because the owner asked for
// it (2026-08-30): *"everything should be setup with not setting it on a hard
// level everything should be able to be configured differently in settings. The
// system is only prefilled with the rules of the system."*
// ============================================================================

/// A gate a condition can block — "prior to submission", "prior to clear to
/// close", and so on. A ROW, not an enum, so a buyer can add, rename or retire
/// one without a migration; `position` orders them on every screen.
model LtConditionBucket {
  id       String  @id @default(uuid()) @db.Uuid
  key      String  @unique(map: "lt_condition_buckets_key_uk")
  label    String
  /// What this gate means, in the words a person reads. Held here rather than in
  /// code so a buyer's own description travels with their own bucket.
  blurb    String?
  position Int     @default(100)
  isActive Boolean @default(true) @map("is_active")
  /// TRUE for a row db/643 seeded — what lets a reseed tell "our default,
  /// untouched" from "a buyer's own gate", so neither overwrites the other.
  isSeeded Boolean @default(false) @map("is_seeded")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @default(now()) @map("updated_at") @db.Timestamptz(6)

  @@map("lt_condition_buckets")
}

/// THE LIBRARY — one row per condition this company can ask for. A file gets a
/// COPY (LtFileCondition), never a pointer: editing a template must not silently
/// rewrite what a borrower was already told on a file somebody is working.
model LtConditionTemplate {
  id        String @id @default(uuid()) @db.Uuid
  code      String @unique(map: "lt_condition_templates_code_uk")
  bucketKey String @map("bucket_key")

  /// The team's wording, and the borrower's. A borrower-facing condition with no
  /// borrower wording is applied STAFF-ONLY by the engine rather than shown to a
  /// client under an internal label.
  label         String
  hint          String?
  borrowerLabel String? @map("borrower_label")
  borrowerHint  String? @map("borrower_hint")

  /// 'internal' | 'external' | 'both'. Three values rather than a boolean: a
  /// condition can be BOTH, and collapsing that is how one ends up either
  /// invisible to whoever must satisfy it or exposed to a borrower it was never
  /// written for.
  audience String @default("internal")
  /// The owner's own taxonomy: informational | form | order | esign | document.
  kind String @default("document")
  /// 'always' | 'rules' | 'manual'.
  autoApply String @default("manual") @map("auto_apply")
  /// `{combinator, rules:[…]}`, one level of nesting. NOTHING IN IT IS EVER
  /// EVALUATED AS CODE: it names field keys the engine's registry carries, and a
  /// key the registry does not carry makes the rule refuse rather than match.
  ruleLogic Json? @map("rule_logic")

  isRequired Boolean @default(true) @map("is_required")
  /// The named places a document goes ("Binder", "Invoice"). jsonb because a slot
  /// has no life of its own and is never queried across files.
  slots  Json @default("[]")
  /// This condition's own settings — which appraisal form for which property
  /// type, which vendors an order may go to. Every condition's shape is its own.
  config Json @default("{}")

  /// BUILT but deliberately not switched on. Distinct from `isActive = false`,
  /// which is a buyer retiring one: this shows on the file, greyed, WITH ITS
  /// REASON, so nobody thinks a feature vanished.
  isEnabled      Boolean @default(true) @map("is_enabled")
  disabledReason String? @map("disabled_reason")

  isActive  Boolean  @default(true) @map("is_active")
  sortOrder Int      @default(100) @map("sort_order")
  isSeeded  Boolean  @default(false) @map("is_seeded")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @default(now()) @map("updated_at") @db.Timestamptz(6)

  @@index([bucketKey, sortOrder], map: "lt_condition_templates_bucket_idx")
  @@map("lt_condition_templates")
}

/// One loan's own conditions. The WORDING IS A SNAPSHOT, not a join — editing
/// the library must not change what a borrower was already asked for on a live
/// file, and a template retired next year must not blank the condition a file
/// was cleared on.
model LtFileCondition {
  id         String  @id @default(uuid()) @db.Uuid
  loanId     String  @map("loan_id") @db.Uuid
  templateId String? @map("template_id") @db.Uuid
  code       String?
  bucketKey  String  @map("bucket_key")
  /// Lets ONE template legitimately appear twice on a file — one per borrower,
  /// one per property — told apart by a key rather than by two look-alike rows.
  fieldKey String? @map("field_key")

  label         String
  hint          String?
  borrowerLabel String? @map("borrower_label")
  borrowerHint  String? @map("borrower_hint")
  audience      String  @default("internal")
  kind          String  @default("document")
  isRequired    Boolean @default(true) @map("is_required")
  slots         Json    @default("[]")
  config        Json    @default("{}")
  /// What the file has actually answered — a form's fields, an order's chosen
  /// vendor, an acknowledgement. Its shape is the condition's own.
  answer Json @default("{}")

  /// outstanding | in_progress | received | satisfied | waived | not_applicable.
  /// The last three are three DIFFERENT facts and are never collapsed: provided
  /// and accepted, decided not needed here, and never applied at all.
  status String @default("outstanding")
  /// WHY it is on the file. 'auto' is the engine's, and only the engine may
  /// retract one; 'manual' is a person's and is never removed automatically.
  origin    String @default("auto")
  sortOrder Int    @default(100) @map("sort_order")

  notes String?

  satisfiedAt  DateTime? @map("satisfied_at") @db.Timestamptz(6)
  satisfiedBy  String?   @map("satisfied_by") @db.Uuid
  waivedAt     DateTime? @map("waived_at") @db.Timestamptz(6)
  waivedBy     String?   @map("waived_by") @db.Uuid
  waivedReason String?   @map("waived_reason")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @default(now()) @map("updated_at") @db.Timestamptz(6)

  loan  LtLoan              @relation(fields: [loanId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  files LtConditionFile[]
  orders LtFileOrder[]

  @@index([loanId, bucketKey, sortOrder], map: "lt_file_conditions_loan_idx")
  @@index([templateId], map: "lt_file_conditions_template_idx")
  @@map("lt_file_conditions")
}

/// PILOT's OWN documents against one of these conditions — deliberately NOT
/// db/612's `LtDocument`, which is Encompass's eFolder mirrored and would be
/// destroyed by the next mirror pass.
///
/// NOTHING IS EVER DELETED: a superseded document is `isCurrent = false`,
/// because the record of what was once provided is part of the story of the loan
/// and a rejected document's reason is what tells the borrower what to send.
model LtConditionFile {
  id          String  @id @default(uuid()) @db.Uuid
  conditionId String  @map("condition_id") @db.Uuid
  loanId      String  @map("loan_id") @db.Uuid
  /// Which named place on the condition this fills, when it has slots.
  slotKey String? @map("slot_key")

  filename    String
  contentType String? @map("content_type")
  byteSize    BigInt? @map("byte_size")
  sha256      String?
  storageRef  String  @map("storage_ref")

  uploadedBy String? @map("uploaded_by") @db.Uuid
  /// 'staff' | 'borrower' — who put it there, which decides whether it is born
  /// awaiting review. Text rather than a CHECK: a third door (a vendor returning
  /// an order by email) must not need a migration to file its first document.
  uploadedByKind String @default("staff") @map("uploaded_by_kind")

  /// pending | accepted | rejected | superseded. Nothing un-reviewed is ever
  /// treated as fulfilment — `<> 'rejected'` is a test for "nobody threw this
  /// away", not for "somebody checked this".
  reviewStatus String    @default("pending") @map("review_status")
  reviewedAt   DateTime? @map("reviewed_at") @db.Timestamptz(6)
  reviewedBy   String?   @map("reviewed_by") @db.Uuid
  reviewReason String?   @map("review_reason")

  isCurrent Boolean  @default(true) @map("is_current")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  /// Which ORDER this document came back on, when a vendor returned it by email
  /// (db/644). Recorded so a condition can say "this came back from the title
  /// company on the order we placed on the 4th" rather than "somebody uploaded
  /// this". Plain ids, no relation: the order is a record of what we asked for and
  /// must survive the document being superseded, and the reverse.
  orderId      String? @map("order_id") @db.Uuid
  orderEventId String? @map("order_event_id") @db.Uuid

  condition LtFileCondition @relation(fields: [conditionId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@index([loanId, createdAt(sort: Desc)], map: "lt_condition_files_loan_idx")
  @@map("lt_condition_files")
}

/// A vendor a LOAN uses — the title company, the insurance agent, the New York
/// settlement agent — pointing at the SHARED `service_contacts` directory rather
/// than a long-term copy of it (the owner: "You need to make sure you're not
/// copying the information. You're just using the information from the short-term
/// side"). One company, one card, edited in one place.
model LtLoanVendor {
  id     String @id @default(uuid()) @db.Uuid
  loanId String @map("loan_id") @db.Uuid

  /// What this contact is FOR on this loan.
  kind String

  /// A `service_contacts` id, carried with NO foreign key on purpose (db/644's
  /// header says why: CASCADE would let a short-term deletion unlink a live
  /// long-term order, RESTRICT would let a long-term loan block a short-term
  /// admin, and SET NULL leaves an order pointing at nobody with nothing saying
  /// so). A LEFT JOIN reads a removed card as "no longer in the directory" and the
  /// desk's own blocker refuses the order and says why.
  serviceContactId String @map("service_contact_id") @db.Uuid

  /// The card the order is addressed TO. Everyone else on the same kind rides the
  /// Cc, exactly as the short-term desk loops a second title contact in.
  isPrimary Boolean @default(true) @map("is_primary")

  addedBy   String?  @map("added_by") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  loan LtLoan @relation(fields: [loanId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@unique([loanId, kind, serviceContactId], map: "lt_loan_vendors_one_per_kind_uk")
  @@index([serviceContactId], map: "lt_loan_vendors_contact_idx")
  @@map("lt_loan_vendors")
}

/// One vendor order on one loan. The row IS the slot: it exists from the first
/// time anybody looks at that kind on that loan and moves through its statuses in
/// place, so a follow-up, a reply and a returned document all have one thing to
/// attach to — and two people pressing Order at the same moment cannot produce two
/// title orders (db/401's lesson: the unique index is the guarantee, not the read).
model LtFileOrder {
  id     String @id @default(uuid()) @db.Uuid
  loanId String @map("loan_id") @db.Uuid
  kind   String

  /// not_ordered | ordered | documents_in | completed | cancelled. 'ordered' is
  /// only ever written by a send the provider ACCEPTED.
  status String @default("not_ordered")

  /// Which vendor card it actually went to, recorded at send time and kept even if
  /// the loan's vendor choice changes: the question a year later is "who did we
  /// ask?", not "who is on the file now".
  vendorContactId String? @map("vendor_contact_id") @db.Uuid

  /// The thread. The SUBJECT is the load-bearing half (a provider may rewrite our
  /// Message-ID; the subject is what mail clients fall back to).
  subject        String?
  rootMessageId  String? @map("root_message_id")
  lastMessageId  String? @map("last_message_id")
  replyTo        String? @map("reply_to")

  /// The per-order Cc choices, so a follow-up stays on the footing of the order it
  /// follows rather than re-resolving a setting that has since changed.
  ccBorrower Boolean? @map("cc_borrower")
  ccHelper   Boolean? @map("cc_helper")

  orderedBy      String?   @map("ordered_by") @db.Uuid
  orderedAt      DateTime? @map("ordered_at") @db.Timestamptz(6)
  lastFollowupAt DateTime? @map("last_followup_at") @db.Timestamptz(6)
  cancelledAt    DateTime? @map("cancelled_at") @db.Timestamptz(6)
  cancelledBy    String?   @map("cancelled_by") @db.Uuid
  cancelReason   String?   @map("cancel_reason")

  /// Where a returned document is filed: the condition this order answers.
  conditionId String? @map("condition_id") @db.Uuid

  notes     String?
  meta      Json     @default("{}") @db.JsonB
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  loan      LtLoan           @relation(fields: [loanId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  condition LtFileCondition? @relation(fields: [conditionId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  events    LtOrderEvent[]

  @@unique([loanId, kind], map: "lt_file_orders_one_per_kind_uk")
  @@map("lt_file_orders")
}

/// Every message on an order's thread, out and back. The bytes of an attachment go
/// to storage and its row to `lt_condition_files`; this is the receipt.
model LtOrderEvent {
  id      String @id @default(uuid()) @db.Uuid
  orderId String @map("order_id") @db.Uuid
  /// Denormalised so a screen can scope by loan without joining, and so the
  /// inbound handler can refuse a message whose order belongs to another loan.
  loanId  String @map("loan_id") @db.Uuid

  direction String
  msgType   String @default("message") @map("msg_type")

  subject   String?
  fromEmail String?  @map("from_email")
  toEmails  String[] @default([]) @map("to_emails")
  ccEmails  String[] @default([]) @map("cc_emails")
  bodyText  String?  @map("body_text")
  bodyHtml  String?  @map("body_html")

  messageId String? @map("message_id")
  inReplyTo String? @map("in_reply_to")

  /// The provider's own id for an inbound delivery. UNIQUE where present, because
  /// a webhook redelivery must not file the same documents twice.
  inboundId String? @map("inbound_id")

  /// Did this message really come from who it says? Never a gate — a legitimate
  /// reply relayed through a list fails SPF routinely — but SHOWN, above the fold,
  /// before anybody opens an attachment.
  senderAuth Json? @map("sender_auth") @db.JsonB

  attachments Json @default("[]") @db.JsonB
  /// Never silently dropped: what could not be filed, and why.
  skipped     Json @default("[]") @db.JsonB

  status     String?
  staffId    String?  @map("staff_id") @db.Uuid
  occurredAt DateTime @default(now()) @map("occurred_at") @db.Timestamptz(6)

  order LtFileOrder @relation(fields: [orderId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  loan  LtLoan      @relation(fields: [loanId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@unique([inboundId], map: "lt_order_events_inbound_uk")
  @@index([orderId, occurredAt(sort: Desc)], map: "lt_order_events_order_idx")
  @@index([loanId, occurredAt(sort: Desc)], map: "lt_order_events_loan_idx")
  @@map("lt_order_events")
}

/// THE VERIFICATION OF RENT — the form itself. ONE per loan.
///
/// What is stored is the form's DATA, not the rendered PDF: the preview is
/// re-rendered from this on every look and again at the moment of sending, so the
/// document that goes out is by construction the one that was reviewed. A
/// hand-edited PDF could not be re-anchored, and every reader downstream reads the
/// data anyway.
///
/// Deliberately holds OUR half only — the landlord's answers arrive in
/// LtVorReturn. A column that could hold both is a column somebody eventually fills
/// in on the landlord's behalf.
model LtVorForm {
  id     String @id @default(uuid()) @db.Uuid
  loanId String @map("loan_id") @db.Uuid

  /// Keyed by the field keys in src/longterm/vor/fields.js.
  data Json @default("{}") @db.JsonB

  /// Whether a person has looked at the prefill. A form nobody has opened is still
  /// sendable — the prefill is the whole point — but the desk says which it is.
  reviewedBy String?   @map("reviewed_by") @db.Uuid
  reviewedAt DateTime? @map("reviewed_at") @db.Timestamptz(6)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@unique([staffId], map: "lt_term_sheet_cart_staff_uk")
  @@map("lt_term_sheet_cart")
}

/// db/642 — ONE OPTION, on a comparison or on an issued sheet.
///
/// `cartId` points at a cart while `parentKind` is 'cart' and at the SHEET once
/// it is 'sheet' — the members are re-pointed when the sheet is issued and the
/// cart goes with it. `mode` and `waiveLenderFees` are PER MEMBER, which is the
/// owner's three offers: borrower-paid at par beside lender-paid with the fees
/// waived beside lender-paid with a credit, on one document. Raw is refused here
/// too — a sheet whose first option is issuable while a later one is not would
/// otherwise slip past the sheet-level CHECK.
model LtTermSheetScenario {
  id         String @id @default(uuid()) @db.Uuid
  cartId     String @map("cart_id") @db.Uuid
  /// 'cart' | 'sheet' (CHECK lt_term_sheet_scenario_parent_chk)
  parentKind String @default("cart") @map("parent_kind")
  position   Int
  label      String?
  /// 'borrowerPaid' | 'lenderPaid' (CHECK lt_term_sheet_scenario_mode_chk)
  mode            String  @default("lenderPaid")
  waiveLenderFees Boolean @default(false) @map("waive_lender_fees")

  scenario Json @default("{}") @db.JsonB
  program  Json @default("{}") @db.JsonB
  charges  Json @default("{}") @db.JsonB
  closing  Json @default("{}") @db.JsonB

  pricedAt  DateTime @default(now()) @map("priced_at") @db.Timestamptz(6)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@unique([cartId, parentKind, position], map: "lt_term_sheet_scenario_pos_uk")
  @@index([cartId, position], map: "lt_term_sheet_scenario_parent_idx")
  @@map("lt_term_sheet_scenario")
  loan      LtLoan          @relation(fields: [loanId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  envelopes LtVorEnvelope[]

  @@unique([loanId], map: "lt_vor_forms_loan_uk")
  @@map("lt_vor_forms")
}

/// One DocuSign envelope. A re-send after a void is a NEW row, because the landlord
/// genuinely received two and collapsing them would lose which one they signed.
/// This is also the table the inbound Connect claim looks a long-term envelope up
/// in, which is what stops the shared webhook dropping the landlord's signature.
model LtVorEnvelope {
  id     String  @id @default(uuid()) @db.Uuid
  loanId String  @map("loan_id") @db.Uuid
  formId String? @map("form_id") @db.Uuid

  /// DocuSign's own id. NULL for the moment between claiming the row and the
  /// provider answering — which is what makes a lost response recoverable rather
  /// than a second envelope to the same landlord.
  envelopeId String? @map("envelope_id")

  /// created | sent | delivered | completed | declined | voided | failed
  status String @default("created")

  recipientName  String? @map("recipient_name")
  recipientEmail String? @map("recipient_email")

  /// 'docusign' or 'both'. An email-only send creates no envelope at all, which is
  /// why 'email' never appears here.
  sendMethod String @default("docusign") @map("send_method")

  sentBy      String?   @map("sent_by") @db.Uuid
  sentAt      DateTime? @map("sent_at") @db.Timestamptz(6)
  completedAt DateTime? @map("completed_at") @db.Timestamptz(6)

  /// Why an envelope in flight was stopped, in words. The only record afterwards.
  voidReason String?   @map("void_reason")
  voidedAt   DateTime? @map("voided_at") @db.Timestamptz(6)

  lastError String?  @map("last_error")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  loan    LtLoan        @relation(fields: [loanId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  form    LtVorForm?    @relation(fields: [formId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  returns LtVorReturn[]

  @@unique([envelopeId], map: "lt_vor_envelopes_envelope_uk")
  @@index([loanId, createdAt], map: "lt_vor_envelopes_loan_idx")
  @@map("lt_vor_envelopes")
}

/// What came back, however it came back — DocuSign's completed copy, or a form
/// somebody filled in by hand and emailed. Both answer the same question, so both
/// sit on one timeline; that is what makes "a manual return voids the envelope"
/// expressible rather than a rule somebody remembers.
model LtVorReturn {
  id         String  @id @default(uuid()) @db.Uuid
  loanId     String  @map("loan_id") @db.Uuid
  envelopeId String? @map("envelope_id") @db.Uuid

  /// 'docusign' | 'manual'
  source String

  /// The landlord's answers where we have them. A manual return usually has none
  /// until somebody types them in, and an empty object is the honest record of that.
  answers Json @default("{}") @db.JsonB

  storageRef String? @map("storage_ref")
  filename   String?

  recordedBy String?  @map("recorded_by") @db.Uuid
  note       String?
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  loan     LtLoan         @relation(fields: [loanId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  envelope LtVorEnvelope? @relation(fields: [envelopeId], references: [id], onDelete: SetNull, onUpdate: Cascade)

  @@index([loanId, createdAt], map: "lt_vor_returns_loan_idx")
  @@map("lt_vor_returns")
}
