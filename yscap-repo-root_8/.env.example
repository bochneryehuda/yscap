# ---- core ----
NODE_ENV=development
PORT=3000
DATABASE_URL=postgres://user:pass@localhost:5432/yscapital
WEB_DIR=web

# ---- auth / crypto (generate long random values in prod) ----
JWT_SECRET=change-me-long-random
SSN_ENCRYPTION_KEY=change-me-long-random
ACCESS_TTL_SEC=3600
REFRESH_TTL_SEC=2592000

# ---- site intake ----
INTAKE_API_KEY=shared-secret-the-site-sends

# ---- notifications (email fan-out) ----
# EMAIL_PROVIDER: auto | none | graph | resend  (auto infers from the creds set).
# In-app notifications always work regardless.
EMAIL_PROVIDER=auto
# Our emails are repliable — use a REAL monitored sender, not "no-reply".
# Resend needs only the domain verified; Graph needs a real mailbox UPN.
NOTIFY_FROM=PILOT by YS Capital <notifications@yscapgroup.com>
# Guaranteed Reply-To when no per-file address applies — replies always reach a person.
REPLY_TO=sales@yscapgroup.com
# The SALES desk inbox: gets every marketing-site submission with NO routed
# loan officer (a branded ?lo= link or an explicit pick always goes to that
# officer instead) — applications, term sheets, track records, rehab budgets,
# quotes/contact. Set to "" to fall back to the admin-desk fan-out.
SALES_NOTIFY_TO=sales@yscapgroup.com
# Base URL used for verify/reset links inside emails (the portal's public URL):
APP_URL=https://yscap.onrender.com
NOTIFY_ADMINS=admin1@yscapgroup.com,admin2@yscapgroup.com
# Resend (simplest to stand up) — the NOTIFY_FROM domain must be verified in Resend:
RESEND_API_KEY=
# Microsoft Graph (Outlook) — Azure app registration w/ Mail.Send (application):
MS_TENANT_ID=
MS_CLIENT_ID=
MS_CLIENT_SECRET=

# ---- inbound email (replies + the closing chain come BACK into a file) ----
# The whole inbound side is DORMANT until these three are set. Runbook:
# docs/EMAIL-REPLY-INBOX-SETUP.md.
# The domain every unique reply address is built on, e.g.
#   file+<appId>@        a reply reaches the file's whole team
#   title+/insurance+    a vendor's reply + returned documents land on that order
#   closing+<token>@     THE CLOSING CHAIN — the address an outside closing attorney
#                        is asked to keep on the chain they start, so every email and
#                        document on it files onto the loan file
# Unset = emails still send, just with no reply address and no inbound capture.
CHAT_REPLY_DOMAIN=
# The Resend webhook signing secret (whsec_…). The inbound route refuses EVERY
# delivery while this is unset — it fails closed on purpose.
RESEND_WEBHOOK_SECRET=
# A FULL-ACCESS Resend key: the Receiving API must be READ to fetch an inbound
# message's body + attachments. A send-only key cannot. Falls back to RESEND_API_KEY.
RESEND_INBOUND_API_KEY=

# ---- attorney closing prep ----
# The closing attorney GROUP inbox the "file ready for closing prep" order is sent
# to — OUR closing attorney, and the ONLY recipient of the order. Required: the
# file's own "attorney" contact is the BORROWER'S counsel and is handed over in the
# body as a contact, never copied, so blanking this blocks every closing-prep order.
ATTORNEY_GROUP_EMAIL=teamag@privatelenderlaw.com
# Total attachment budget for one closing-prep email. Resend accepts ~40 MB per
# message; Graph rejects inline attachments past ~3 MB, hence the separate budget.
# Nothing is ever silently dropped — whatever does not fit is named in the email.
CLOSING_ATTACH_BUDGET_MB=20
CLOSING_ATTACH_BUDGET_GRAPH_MB=2.5

# ---- document storage ----
STORAGE_PROVIDER=local
STORAGE_DIR=uploads

# ---- document underwriting: OCR reader + AI analyzer (deferred until keys set) ----
# Azure AI Document Intelligence (reads scanned/blurry PDFs). Create a Document
# Intelligence resource in the Azure portal and paste its endpoint + key here. Default
# model 'prebuilt-read' is pure OCR; 2024-11-30 is the current GA API version:
AZURE_DOCINT_ENDPOINT=
AZURE_DOCINT_KEY=
AZURE_DOCINT_MODEL=prebuilt-read
AZURE_DOCINT_API_VERSION=2024-11-30
# Azure OpenAI (GPT-5) — the AI document analyzer. Create an Azure OpenAI resource,
# deploy a GPT-5 model, and paste its endpoint, key, and the deployment name here:
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_KEY=
AZURE_OPENAI_DEPLOYMENT=
AZURE_OPENAI_API_VERSION=2025-04-01-preview
# GPT-5 reasoning depth for extraction: minimal | low | medium | high (default low):
AZURE_OPENAI_REASONING_EFFORT=low

# ---- ClickUp (deferred) ----
CLICKUP_API_TOKEN=

# ---- USPS address verification (official USPS Addresses API) ----
# The authoritative USPS address standardizer. The autocomplete (below) suggests
# an address as you type; USPS then confirms/corrects it to the exact official
# mailing address. Get the two keys FREE at developer.usps.com (create a business
# account, make an app). As of Aug 1 2026 USPS also requires signing their
# Addressing API License Agreement + a paid tier for real volume — see
# docs/USPS-ADDRESS-VERIFICATION.md for the step-by-step buying guide.
USPS_CLIENT_ID=
USPS_CLIENT_SECRET=
# Leave the base URL as-is unless USPS gives you a different host:
USPS_API_BASE=https://apis.usps.com
# Free-tier burst brake (USPS allows 60 lookups/hour, shared across USPS APIs).
# Live verifies AND the backfill share this window. Default 55 (safe for the free
# tier). Set 0 for NO cap once you're on a paid Enhanced Addresses tier. Counter is
# per-process — with multiple app instances, lower it or run one instance.
USPS_MAX_PER_HOUR=55
# Previous-files backfill: stamp every EXISTING file with its USPS-correct address
# (non-destructive). Off by default; turn on once USPS is live + on a paid tier.
USPS_BACKFILL_ENABLED=0
USPS_BACKFILL_PER_TICK=40
USPS_BACKFILL_EVERY_MIN=60
# Required staff condition. It clears only after a verified USPS address is imported.
USPS_CONDITION_REQUIRED=1

# ---- Address autocomplete (typeahead as you type) ----
# Provider auto-selects: Google if GOOGLE_PLACES_API_KEY is set, else Smarty if
# SMARTY_AUTH_ID is set, else free keyless OpenStreetMap. USPS (above) verifies
# whatever the provider suggests. OSM asks for a contact email in its user-agent.
ADDRESS_PROVIDER=
GOOGLE_PLACES_API_KEY=
SMARTY_AUTH_ID=
SMARTY_AUTH_TOKEN=
OSM_CONTACT=admin@yscapgroup.com

# ---- SharePoint one-way sync (Pipeline Drive mirror) ----
# Mirrors every document into Pipeline Drive/<Officer>/<Borrower>/<Address>/
# YS portal syncing/<Condition>/ — write-only, never deletes (docs/SHAREPOINT-POLICY.md).
# Uses the MS_* Graph app credentials above. Master switch (0/1):
SHAREPOINT_BACKUP_ENABLED=0
# Pin the document-library drive id (from Graph /sites/{site}/drives). When set,
# host/path/name below are only a fallback:
SHAREPOINT_DRIVE_ID=
SHAREPOINT_SITE_HOST=yscapgroup.sharepoint.com
SHAREPOINT_SITE_PATH=/sites/SharedData
SHAREPOINT_DRIVE_NAME=Documents
SHAREPOINT_PIPELINE_ROOT=Pipeline Drive
# Optional certificate auth (preferred over the secret when present; PEM with
# both PRIVATE KEY and CERTIFICATE blocks, or base64 of it in _B64):
MS_CLIENT_CERT_PEM=
MS_CLIENT_CERT_PEM_B64=
# Sweep interval in seconds (uploads also kick an immediate pass):
SHAREPOINT_BACKUP_POLL_SEC=300

# ---- Xactus credit reports — SHARED PRODUCTION login (the "Import credit" button) ----
# ONE company login used for every pull (not per-user). Set these three to turn on
# live pulls/reissues from the internal Credit report condition. Until they are set,
# staff can still import a report downloaded from Xactus (XML + PDF).
# XACTUS_API_URL = the FULL Credit ReportX request URL Xactus gave you (the exact
# endpoint reports are POSTed to — NOT just a base host like https://api.xactus.com).
XACTUS_API_URL=
XACTUS_API_USERNAME=
XACTUS_API_PASSWORD=
# Optional — only if the Xactus setup guide requires them:
XACTUS_API_ACCOUNT=
XACTUS_API_CLIENT_ID=
# Default report interface version shown on the import screen (owner-directed 3.4):
XACTUS_INTERFACE_VERSION=3.4
# RequestingParty name printed in the MISMO request (informational; defaults to
# "YS Capital Group"):
XACTUS_REQUESTING_PARTY=
# Auth style: 'basic' (HTTP Basic header, the documented default) or 'query'
# (LoginAccountIdentifier/LoginAccountPassword query params). Leave unset for basic.
XACTUS_AUTH_MODE=

# ---- Encompass (ICE Mortgage Technology / Ellie Mae) — the loan-origination system ----
# READ-ONLY connection: PILOT pulls loan data from Encompass and never changes
# anything there (the one exception is flood ordering, below). The whole integration
# stays dormant until the client id / secret / instance are set. Get them from your
# ICE Developer Connect account / your Encompass admin.
#   CLIENT_ID / CLIENT_SECRET = the keys for your Encompass API app.
#   INSTANCE_ID               = your Encompass instance id (a.k.a. smart-client id).
#   USERNAME / PASSWORD       = only needed if your API access uses a user login
#                               (password grant). Leave blank for a client-credentials
#                               app. Ordering a service usually needs a real user.
ENCOMPASS_CLIENT_ID=
ENCOMPASS_CLIENT_SECRET=
ENCOMPASS_INSTANCE_ID=
ENCOMPASS_USERNAME=
ENCOMPASS_PASSWORD=
# Leave the base URL as-is unless ICE gives you a different host:
ENCOMPASS_API_BASE=https://api.elliemae.com

# ---- Encompass FLOOD ordering — the ONE write into Encompass (flood only) ----
# The "Order flood certificate" button on the flood condition orders a Life-of-Loan
# flood determination from ICE's own flood service and files the certificate PDF back
# onto the file. By default it reuses the Encompass credentials above.
#
# REQUIRED to actually place an order: your flood "service setup id" — it tells
# Encompass WHICH flood vendor/service to order from. Ask your Encompass admin for it.
# Without it, ordering is refused up front (Encompass would answer
# "SOO-1125: serviceSetupId is required").
ENCOMPASS_FLOOD_SERVICE_SETUP_ID=
# Optional: a dedicated flood-authorized login, ONLY if the read-only user above
# cannot order services. Any of these override the base creds for flood ordering:
ENCOMPASS_FLOOD_CLIENT_ID=
ENCOMPASS_FLOOD_CLIENT_SECRET=
ENCOMPASS_FLOOD_INSTANCE_ID=
ENCOMPASS_FLOOD_USERNAME=
ENCOMPASS_FLOOD_PASSWORD=
# Switches (also flippable live on the API-Health page, no redeploy). Master + write
# default ON. TEST MODE builds + logs the order but sends NOTHING (safe to leave on
# while verifying). Set a value to '0' to pause; set DRYRUN to '1' to test.
ENCOMPASS_FLOOD_ENABLED=1
ENCOMPASS_FLOOD_OUTBOUND_ENABLED=1
ENCOMPASS_FLOOD_DRYRUN=0
# Advanced — only if the live order body needs tuning (a dry-run prints the exact
# body to the server logs). Framework 'serviceOrders' (default) uses the service
# setup id above; 'partnerTransactions' uses PARTNER_ID instead:
ENCOMPASS_FLOOD_FRAMEWORK=serviceOrders
ENCOMPASS_FLOOD_PARTNER_ID=
ENCOMPASS_FLOOD_SERVICE_ID=
ENCOMPASS_FLOOD_PRODUCT=Life of Loan Flood Determination
ENCOMPASS_FLOOD_REASON=Manually Requested
ENCOMPASS_FLOOD_REQUEST_TYPE=Flood
ENCOMPASS_FLOOD_SCOPE=
ENCOMPASS_FLOOD_OPTIONS_JSON=

# ---- Xactus "Flood ReportX" — the ACTIVE flood-cert provider (MISMO 2.4) ----
# The "Order flood certificate" button orders a flood determination from Xactus
# (cheaper than Encompass) and files the certificate PDF onto the flood condition.
# Which provider the button uses: 'xactus' (default) or 'encompass' (parked).
FLOOD_ORDER_PROVIDER=xactus
# REQUIRED — the flood web address. Flood ReportX is MISMO 2.4, a DIFFERENT endpoint
# than the MISMO 3.4 CREDIT endpoint (e.g. credit .../uaweb/mismo3 → flood .../uaweb/mismo2).
# It does NOT fall back to XACTUS_API_URL, so this MUST be set or the button won't order.
XACTUS_FLOOD_API_URL=
# The LOGIN falls back to the credit login (XACTUS_API_USERNAME/PASSWORD) — same Xactus
# account. Set these ONLY if Xactus gave you a separate flood username/password:
XACTUS_FLOOD_USERNAME=
XACTUS_FLOOD_PASSWORD=
# 'life' = Life-of-Loan (monitored, the mortgage default) | 'basic' = one-time (cheaper):
XACTUS_FLOOD_PRODUCT=life
# Flood ReportX auth is URL QUERY PARAMS (LoginAccountIdentifier/LoginAccountPassword),
# per the Xactus Postman collection — this is the DEFAULT, leave blank. Set 'basic' ONLY
# if Xactus says this account uses an HTTP Basic header. Report version defaults to 2.4:
XACTUS_FLOOD_AUTH_MODE=
XACTUS_FLOOD_VERSION=2.4
# Master switch (default ON). Flood ordering is LIVE by default (owner-directed
# go-live) — a staff click places a real, billable order (nothing orders on its own).
# There is NO test/dry-run mode for Xactus flood (removed owner-directed 2026-08-02):
# turn the whole thing off with XACTUS_FLOOD_ENABLED=0 if you need to pause it.
XACTUS_FLOOD_ENABLED=1

# ============================================================================
# OFF-SITE BACKUP (owner-directed 2026-08-02)
# ============================================================================
# Full setup guide, vendor comparison and the restore runbook:
#   docs/DATABASE-BACKUP-AND-RESTORE.md
#
# These belong to the BACKUP CRON JOB, not to the web service. The portal never
# reads them and is completely unaffected if they are blank.
#
# Check the wiring at any time WITHOUT writing anything:
#   npm run backup:preflight

# --- 1. THE KEY -------------------------------------------------------------
# Encrypts every backup on our machine, before a byte leaves it. The storage
# vendor only ever holds ciphertext.
#   Generate ONCE:  openssl rand -base64 32
# Then store it in the company password manager AND somewhere offline. If this
# is lost, every backup ever taken is permanently unreadable — by an attacker
# and by us. Changing it does NOT re-encrypt old backups; keep the old key for
# as long as backups written with it are still in the vault.
BACKUP_ENCRYPTION_KEY=

# --- 2. THE VAULT -----------------------------------------------------------
# An S3-compatible bucket at a DIFFERENT provider from Render. Works with AWS
# S3, Cloudflare R2, Backblaze B2, Wasabi.
#
# CHOSEN (owner-directed 2026-08-02): Cloudflare R2 — a DEDICATED backup bucket
# with its OWN API token scoped to that bucket alone. It must never be the
# documents bucket (S3_* above) and never the documents token: keeping the two
# credentials apart is what stops a leaked documents key erasing the backups.
#   BACKUP_S3_ENDPOINT = https://<account-id>.r2.cloudflarestorage.com
#   BACKUP_S3_REGION   = auto
BACKUP_S3_BUCKET=
BACKUP_S3_ENDPOINT=
BACKUP_S3_ACCESS_KEY_ID=
BACKUP_S3_SECRET_ACCESS_KEY=
BACKUP_S3_REGION=
# Optional folder inside the bucket:
BACKUP_S3_PREFIX=
# WORM immutability. COMPLIANCE means a stored backup cannot be deleted or
# altered by ANYONE — including us, including the account root — until the days
# below have passed. This is what makes the backups ransomware-proof.
#
# ON CLOUDFLARE R2 (our vault): LEAVE THIS BLANK. R2 does not implement the S3
# per-object Object Lock API; it protects the whole bucket instead, via a
# "bucket lock" rule you set in the Cloudflare dashboard. Set that rule to 35
# days — matching BACKUP_KEEP_DAILY_DAYS below, so the nightly prune only ever
# deletes objects whose lock has already expired. A mode set here would send
# headers R2 does not accept.
#
# ON AWS S3 / BACKBLAZE B2: set COMPLIANCE, and note the bucket must have been
# CREATED with Object Lock enabled (it cannot be turned on later).
BACKUP_S3_OBJECT_LOCK_MODE=
BACKUP_S3_OBJECT_LOCK_DAYS=35
# Upload chunk size (MB) — only worth changing on a very slow link. Minimum 5.
BACKUP_S3_PART_MB=32

# --- 3. A SECOND VAULT (optional, recommended) ------------------------------
# Every backup is written to both. Use a different vendor again, so no single
# company, account or region holds the only copy.
BACKUP_S3_SECONDARY_BUCKET=
BACKUP_S3_SECONDARY_ENDPOINT=
BACKUP_S3_SECONDARY_ACCESS_KEY_ID=
BACKUP_S3_SECONDARY_SECRET_ACCESS_KEY=
BACKUP_S3_SECONDARY_REGION=

# --- 4. HOW LONG BACKUPS ARE KEPT -------------------------------------------
# Grandfather-father-son. Defaults keep every night for 5 weeks, then one a week
# for 6 months, one a month for 3 years, one a year for 10.
BACKUP_KEEP_DAILY_DAYS=35
BACKUP_KEEP_WEEKLY_WEEKS=26
BACKUP_KEEP_MONTHLY_MONTHS=36
BACKUP_KEEP_YEARLY_YEARS=10
# Hard floor: if a prune would leave fewer backups than this, it deletes NOTHING.
BACKUP_KEEP_MINIMUM=7

# --- 5. ALERTS --------------------------------------------------------------
# Where "the backup failed" is emailed. Falls back to NOTIFY_ADMINS. Leave this
# blank and nobody is told when the backups stop — which is the whole failure
# this system exists to prevent.
BACKUP_ALERT_EMAIL=
# Email on a clean nightly run too (off by default — it becomes noise). The
# WEEKLY RESTORE TEST sets this itself; that one is worth reading.
BACKUP_ALERT_ON_SUCCESS=

# --- 6. THE WEEKLY RESTORE TEST ---------------------------------------------
# A throwaway database the test restores INTO. EVERYTHING IN IT IS DELETED on
# every run. The name must contain "verify", "scratch" or "drill", and it
# can never be the live database — both are refused. Leave blank and the test
# still proves the backup file is intact; it just cannot prove it loads.
BACKUP_VERIFY_DATABASE_URL=
# How old the newest backup may be before the WEEKLY DRILL treats it as an
# incident instead of a clean pass. The nightly emails only on failure, and a
# job that never runs never fails, so it goes silent — while the drill happily
# restores an ever-older backup and reports "passed". 48h clears one late run
# without excusing a missed night. 0 disables it (not recommended).
BACKUP_VERIFY_MAX_AGE_HOURS=48

# --- THE DAILY WATCH (set these on the WEB service, not on either cron) ------
# The drill above reports a stopped nightly, but it only runs WEEKLY — so a
# backup that stops on Monday is not noticed until Sunday. The web service is
# awake anyway and reads the same ledger, so it checks every morning and emails
# if the newest good backup is older than this. Silence means all is well.
# 36h = one missed night plus half a day, so a merely LATE run never cries wolf.
# 0 disables it.
BACKUP_WATCH_MAX_AGE_HOURS=36
# How many days a passing restore drill stays believable before that same daily
# watch mentions it. Separate, quieter message — backups being taken but not
# tested is a different problem from no backups. Must clear a missed week.
BACKUP_WATCH_VERIFY_STALE_DAYS=10
# NOTE: the watch emails through BACKUP_ALERT_EMAIL, falling back to
# NOTIFY_ADMINS. If neither is set on the web service, nobody is told.

# --- 7. ADVANCED ------------------------------------------------------------
# Back up a different database (e.g. a read replica) instead of DATABASE_URL:
BACKUP_DATABASE_URL=
# Scratch space for the encrypted dump before upload (deleted afterwards).
BACKUP_TEMP_DIR=
# Upload straight from the dump with no scratch file. Uses almost no disk, but
# a failed upload re-runs the whole dump and only the FIRST vault is written.
BACKUP_STREAM_DIRECT=
# Copy the loan documents (PDFs) into the vault as well. ON by default — a
# database restored without them is every loan file with no paperwork.
BACKUP_DOCUMENTS=
# Ceiling on documents copied per run, so the first run cannot run for hours.
# The rest are picked up by the next run.
BACKUP_DOCUMENTS_PER_RUN=5000
