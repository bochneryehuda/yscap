  id                                                                           BigInt        @id @default(autoincrement())
  tp_project_id                                                                String        @unique
  application_id                                                               String?       @unique @db.Uuid
  matched_by                                                                   String?
  match_detail                                                                 String?
  confirmed_by                                                                 String?       @db.Uuid
  candidate_application_id                                                     String?       @db.Uuid
  candidate_reason                                                             String?
  loan_external_id                                                             String?
  project_name                                                                 String?
  address_text                                                                 String?
  tp_status                                                                    String?
  discarded                                                                    Boolean       @default(false)
  raw                                                                          Json?
  created_at                                                                   DateTime      @default(now()) @db.Timestamptz(6)
  updated_at                                                                   DateTime      @default(now()) @db.Timestamptz(6)
  baselined_at                                                                 DateTime?     @db.Timestamptz(6)
  applications_trustpoint_project_links_application_idToapplications           applications? @relation("trustpoint_project_links_application_idToapplications", fields: [application_id], references: [id], onUpdate: NoAction)
  applications_trustpoint_project_links_candidate_application_idToapplications applications? @relation("trustpoint_project_links_candidate_application_idToapplications", fields: [candidate_application_id], references: [id], onUpdate: NoAction)
  staff_users                                                                  staff_users?  @relation(fields: [confirmed_by], references: [id], onUpdate: NoAction)
}

model trustpoint_pull_field_change {
  id             BigInt   @id @default(autoincrement())
  application_id String?  @db.Uuid
  tp_draw_id     String?
  entity         String
  entity_id      String?
  field          String
  old_value      String?
  new_value      String?
  reacted        Boolean  @default(false)
  created_at     DateTime @default(now()) @db.Timestamptz(6)

  @@index([application_id, created_at(sort: Desc)], map: "idx_tppfc_app")
}

model trustpoint_service_orders {
  tp_service_order_id      String        @id
  application_id           String?       @db.Uuid
  tp_project_id            String
  tp_draw_id               String?
  service_type             String?
  status                   String?
  service_number           String?
  ordered_at               DateTime?     @db.Timestamptz(6)
  scheduled_at             DateTime?     @db.Timestamptz(6)
  completed_at             DateTime?     @db.Timestamptz(6)
  cancelled_at             DateTime?     @db.Timestamptz(6)
  inspector_allowance_rate Decimal?      @db.Decimal
  status_synced            String?
  raw                      Json?
  updated_at               DateTime      @default(now()) @db.Timestamptz(6)
  applications             applications? @relation(fields: [application_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([application_id], map: "idx_tpso_app")
}

model trustpoint_state {
  key        String   @id
  value      String?
  updated_at DateTime @default(now()) @db.Timestamptz(6)
}

model trustpoint_webhook_events {
  id                  BigInt    @id @default(autoincrement())
  event               String
  tp_project_id       String?
  tp_draw_id          String?
  tp_service_order_id String?
  loan_id             String?
  payload             Json
  payload_hash        String
  received_at         DateTime  @default(now()) @db.Timestamptz(6)
  processed_at        DateTime? @db.Timestamptz(6)
  process_error       String?
  attempts            Int       @default(0)

  @@unique([event, payload_hash])
}

model trustpoint_write_log {
  id             BigInt   @id @default(autoincrement())
  application_id String?  @db.Uuid
  endpoint       String
  method         String
  body           Json?
  response       Json?
  ok             Boolean?
  created_at     DateTime @default(now()) @db.Timestamptz(6)
}

model underwriting_conflicts {
  id                                                                           String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  application_id                                                               String             @db.Uuid
  field_key                                                                    String?
  observation_a_id                                                             String?            @db.Uuid
  observation_b_id                                                             String?            @db.Uuid
  value_a                                                                      String?
  value_b                                                                      String?
  category                                                                     String             @default("needs_adjudication")
  materiality                                                                  String?
  status                                                                       String             @default("pending")
  condition_eligible                                                           Boolean            @default(false)
  reason                                                                       String?
  guideline_rule_id                                                            String?            @db.Uuid
  adjudicated_by                                                               String?
  evidence                                                                     Json               @default("{}")
  created_at                                                                   DateTime           @default(now()) @db.Timestamptz(6)
  updated_at                                                                   DateTime           @default(now()) @db.Timestamptz(6)
  applications                                                                 applications       @relation(fields: [application_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  fact_observations_underwriting_conflicts_observation_a_idTofact_observations fact_observations? @relation("underwriting_conflicts_observation_a_idTofact_observations", fields: [observation_a_id], references: [id], onUpdate: NoAction)
  fact_observations_underwriting_conflicts_observation_b_idTofact_observations fact_observations? @relation("underwriting_conflicts_observation_b_idTofact_observations", fields: [observation_b_id], references: [id], onUpdate: NoAction)

  @@index([application_id, status], map: "idx_uw_conflicts_app")
}

model underwriting_context_snapshots {
  id             String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  application_id String       @db.Uuid
  produced_for   String?
  investor_id    String?      @db.Uuid
  program        String?
  snapshot       Json         @default("{}")
  as_of          DateTime?    @db.Date
  created_by     String?      @db.Uuid
  created_at     DateTime     @default(now()) @db.Timestamptz(6)
  applications   applications @relation(fields: [application_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  staff_users    staff_users? @relation(fields: [created_by], references: [id], onUpdate: NoAction)
  investors      investors?   @relation(fields: [investor_id], references: [id], onUpdate: NoAction)

  @@index([application_id, created_at], map: "idx_uw_context_snapshots_app")
}

model underwriting_reread_state {
  application_id String       @id @db.Uuid
  generation     Int          @default(0)
  docs_read      Int          @default(0)
  last_error     String?
  last_read_at   DateTime?    @db.Timestamptz(6)
  updated_at     DateTime     @default(now()) @db.Timestamptz(6)
  applications   applications @relation(fields: [application_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([generation], map: "idx_uw_reread_gen")
}

model underwriting_run_calculations {
  id                String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  run_id            String            @db.Uuid
  metric            String
  formula           String?
  numerator         Decimal?          @db.Decimal
  denominator       Decimal?          @db.Decimal
  result            Decimal?          @db.Decimal
  cap               Decimal?          @db.Decimal
  passed            Boolean?
  binding           Boolean           @default(false)
  sources           Json              @default("{}")
  created_at        DateTime          @default(now()) @db.Timestamptz(6)
  underwriting_runs underwriting_runs @relation(fields: [run_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([run_id], map: "idx_uw_run_calcs_run")
}

model underwriting_run_decisions {
  id                           String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  run_id                       String            @unique(map: "idx_uw_run_decisions_run") @db.Uuid
  status                       String
  decision_reasons             Json              @default("[]")
  conditions_to_add            Json              @default("[]")
  conditions_eligible_to_clear Json              @default("[]")
  exceptions                   Json              @default("[]")
  created_at                   DateTime          @default(now()) @db.Timestamptz(6)
  underwriting_runs            underwriting_runs @relation(fields: [run_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
}

model underwriting_run_findings {
  id                String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  run_id            String            @db.Uuid
  code              String?
  severity          String?
  category          String?
  title             String?
  explanation       String?
  governing_rule    String?
  expected_value    String?
  actual_value      String?
  source            String?
  source_version    String?
  blocks_term_sheet Boolean           @default(false)
  blocks_ctc        Boolean           @default(false)
  blocks_funding    Boolean           @default(false)
  permitted_actions Json              @default("[]")
  created_at        DateTime          @default(now()) @db.Timestamptz(6)
  underwriting_runs underwriting_runs @relation(fields: [run_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([run_id, severity], map: "idx_uw_run_findings_run")
}

model underwriting_run_snapshots {
  id                String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  run_id            String            @unique(map: "idx_uw_run_snapshots_run") @db.Uuid
  context           Json              @default("{}")
  created_at        DateTime          @default(now()) @db.Timestamptz(6)
  underwriting_runs underwriting_runs @relation(fields: [run_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
}

/// One complete automated read of a whole loan file.
model underwriting_runs {
  id                            String                          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  application_id                String                          @db.Uuid
  as_of                         DateTime                        @default(now()) @db.Timestamptz(6)
  trigger                       String                          @default("manual_run")
  source_hash                   String?
  source_versions               Json                            @default("{}")
  program_key                   String?
  status                        String?
  term_sheet_eligible           Boolean                         @default(false)
  ctc_eligible                  Boolean                         @default(false)
  funding_eligible              Boolean                         @default(false)
  superseded_at                 DateTime?                       @db.Timestamptz(6)
  created_by                    String?                         @db.Uuid
  created_at                    DateTime                        @default(now()) @db.Timestamptz(6)
  underwriting_run_calculations underwriting_run_calculations[]
  underwriting_run_decisions    underwriting_run_decisions?
  underwriting_run_findings     underwriting_run_findings[]
  underwriting_run_snapshots    underwriting_run_snapshots?
  applications                  applications                    @relation(fields: [application_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  staff_users                   staff_users?                    @relation(fields: [created_by], references: [id], onUpdate: NoAction)

  @@index([application_id, created_at(sort: Desc)], map: "idx_uw_runs_app")
}

model usps_address_verifications {
  address_hash String   @id
  input        Json
  standardized Json?
  dpv          Json?
  status       String
  verified_at  DateTime @default(now()) @db.Timestamptz(6)

  @@index([verified_at])
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model workflow_events {
  id                                                      String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  workflow_item_id                                        String         @db.Uuid
  application_id                                          String         @db.Uuid
  event_type                                              String
  actor_staff_id                                          String?        @db.Uuid
  from_staff_id                                           String?        @db.Uuid
  to_staff_id                                             String?        @db.Uuid
  submission_type                                         String?
  outcome_label                                           String?
  note                                                    String?
  created_at                                              DateTime       @default(now()) @db.Timestamptz(6)
  staff_users_workflow_events_actor_staff_idTostaff_users staff_users?   @relation("workflow_events_actor_staff_idTostaff_users", fields: [actor_staff_id], references: [id], onUpdate: NoAction)
  staff_users_workflow_events_from_staff_idTostaff_users  staff_users?   @relation("workflow_events_from_staff_idTostaff_users", fields: [from_staff_id], references: [id], onUpdate: NoAction)
  staff_users_workflow_events_to_staff_idTostaff_users    staff_users?   @relation("workflow_events_to_staff_idTostaff_users", fields: [to_staff_id], references: [id], onUpdate: NoAction)
  workflow_items                                          workflow_items @relation(fields: [workflow_item_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([actor_staff_id, created_at(sort: Desc)], map: "idx_wfe_actor")
  @@index([application_id, created_at], map: "idx_wfe_app")
  @@index([workflow_item_id, created_at], map: "idx_wfe_item")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model workflow_items {
  id                                                    String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  application_id                                        String             @db.Uuid
  submission_type                                       String
  from_staff_id                                         String?            @db.Uuid
  to_staff_id                                           String?            @db.Uuid
  to_role                                               String?
  status                                                String             @default("open")
  outcome_label                                         String?
  note                                                  String?
  priority                                              Int                @default(0) @db.SmallInt
  est_closing_date                                      DateTime?          @db.Date
  received_at                                           DateTime           @default(now()) @db.Timestamptz(6)
  picked_up_at                                          DateTime?          @db.Timestamptz(6)
  returned_at                                           DateTime?          @db.Timestamptz(6)
  created_at                                            DateTime           @default(now()) @db.Timestamptz(6)
  updated_at                                            DateTime           @default(now()) @db.Timestamptz(6)
  due_at                                                DateTime?          @db.Timestamptz(6)
  sla_hours                                             Int?               @db.SmallInt
  auto                                                  Boolean            @default(false)
  closing_workflow                                      closing_workflow[]
  workflow_events                                       workflow_events[]
  applications                                          applications       @relation(fields: [application_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  staff_users_workflow_items_from_staff_idTostaff_users staff_users?       @relation("workflow_items_from_staff_idTostaff_users", fields: [from_staff_id], references: [id], onUpdate: NoAction)
  staff_users_workflow_items_to_staff_idTostaff_users   staff_users?       @relation("workflow_items_to_staff_idTostaff_users", fields: [to_staff_id], references: [id], onUpdate: NoAction)

  @@index([application_id, status], map: "idx_wf_app")
  @@index([to_role, status, received_at], map: "idx_wf_to_role")
  @@index([to_staff_id, status, received_at], map: "idx_wf_to_staff")
}

