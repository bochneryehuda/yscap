      { "when": { "unitsMin": 2 }, "result": "standard" }
    ]},
    "MN": { "rules": [
      { "when": { "unitsMax": 4, "loanAmountLe": 832750 }, "result": "prohibited", "note": "business decision; threshold changes annually (2026 $832,750)" },
