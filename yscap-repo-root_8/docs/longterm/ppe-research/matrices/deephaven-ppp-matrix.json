      { "when": { "unitsMin": 3 }, "result": "standard" }
    ]},
    "RI": { "rules": [
      { "when": { "unitsMax": 4 }, "result": "restricted", "terms": "1-year Max; 2% of balance due at payoff; can only be charged at prepayment in full." },
